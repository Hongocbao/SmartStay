@{
    ViewData["Title"] = "Cấp Mã Khách Vãng Lai & Khóa Thông Minh IoT - SmartStay";
}

<!-- Alert thông báo -->
<div id="passAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm mb-4" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="passAlertText">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('passAlert').classList.add('d-none')"></button>
</div>

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success text-white px-2 py-1 fs-9 rounded-pill">DIGITAL KEYLESS</span>
                <span class="badge bg-primary-subtle text-primary border px-2 py-1 fs-9 rounded-pill">Smart IoT Pass</span>
            </div>
            <h4 class="fw-bold mb-1 text-slate-900"><i class="bi bi-qr-code text-success me-2"></i>Cấp Mã Khách Vãng Lai & Vé Điện Tử Tạm Thời (Digital Guest Pass)</h4>
            <p class="text-muted fs-8 mb-0">Cư dân P.305 tự tạo mã QR hoặc mã PIN tạm thời có giới hạn giờ cho bạn bè/người thân đến thăm. Hệ thống tự động ghi nhật ký ra vào bảo đảm an ninh</p>
        </div>
        <div>
            <button class="btn btn-sm btn-primary rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreatePass">
                <i class="bi bi-plus-lg me-1"></i> Tạo Vé Khách Mới
            </button>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Thẻ Khóa Thông Minh Căn Hộ -->
    <div class="col-lg-4">
        <div class="card-custom h-100">
            <h6 class="fw-bold text-slate-800 mb-3"><i class="bi bi-door-closed-fill text-primary me-2"></i>Khóa Cửa Căn Hộ P.305</h6>
            <div class="p-3 rounded-3 bg-light border text-center mb-3">
                <i class="bi bi-lock-fill fs-1 text-success mb-2 d-inline-block"></i>
                <div class="fw-bold fs-6 text-slate-900">LOCK-A-305 (Trạng Thái: Đang Khóa)</div>
                <div class="text-muted fs-8">Mức pin: <strong>92% (Tốt)</strong> • WiFi: <strong>Mạnh</strong></div>
                <div class="badge bg-success-subtle text-success mt-2">Mã PIN Thường Trực: 305888</div>
            </div>
            <button class="btn btn-sm btn-outline-success w-100 rounded-3 shadow-sm" onclick="sendUnlockSignal()">
                <i class="bi bi-unlock-fill me-1"></i> Mở Cửa Ngay Từ Xa (Remote Unlock)
            </button>
        </div>
    </div>

    <!-- Danh Sách Vé Khách Đang Còn Hiệu Lực -->
    <div class="col-lg-8">
        <div class="card-custom h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-slate-800 mb-0"><i class="bi bi-ticket-perforated-fill text-warning me-2"></i>Mã Khách Vãng Lai Đang Có Hiệu Lực (2 Vé)</h6>
                <span class="fs-9 text-muted">Tự động hủy khi hết hạn</span>
            </div>

            <div class="row g-3" id="activePassList">
                <!-- Vé 1: Bạn đại học -->
                <div class="col-md-6" id="pass-01">
                    <div class="p-3 rounded-3 bg-light border position-relative h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-success text-white fs-9">Còn 1 giờ 45 phút</span>
                                <h6 class="fw-bold mb-0 mt-1">Lê Minh Tuấn (Bạn ĐH)</h6>
                            </div>
                            <button class="btn btn-xs btn-outline-danger rounded-pill" onclick="revokePass('pass-01', 'Lê Minh Tuấn')">
                                <i class="bi bi-x-circle"></i> Hủy vé
                            </button>
                        </div>
                        <div class="fs-8 text-muted mb-2">Mã PIN cửa sảnh: <strong class="text-primary fs-6">#8821</strong></div>
                        <div class="text-center p-2 rounded-2 bg-white border mb-2">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=SMARTSTAY_GUEST_PASS_P305_TUAN" alt="QR Pass" class="img-fluid" style="width: 100px; height: 100px;">
                            <div class="fs-9 text-muted mt-1">Quét tại đầu đọc RFID sảnh A</div>
                        </div>
                        <button class="btn btn-xs btn-outline-primary w-100 rounded-pill" onclick="sharePass('Lê Minh Tuấn', '#8821')">
                            <i class="bi bi-share me-1"></i> Gửi link mã qua Zalo / SMS
                        </button>
                    </div>
                </div>

                <!-- Vé 2: Shipper Shopee -->
                <div class="col-md-6" id="pass-02">
                    <div class="p-3 rounded-3 bg-light border position-relative h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="badge bg-warning text-dark fs-9">Vé 1 lần (Single-use)</span>
                                <h6 class="fw-bold mb-0 mt-1">Shipper Giao Hàng</h6>
                            </div>
                            <button class="btn btn-xs btn-outline-danger rounded-pill" onclick="revokePass('pass-02', 'Shipper Giao Hàng')">
                                <i class="bi bi-x-circle"></i> Hủy vé
                            </button>
                        </div>
                        <div class="fs-8 text-muted mb-2">Mã PIN cửa sảnh: <strong class="text-primary fs-6">#4902</strong></div>
                        <div class="text-center p-2 rounded-2 bg-white border mb-2">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=SMARTSTAY_GUEST_PASS_P305_SHIPPER" alt="QR Pass" class="img-fluid" style="width: 100px; height: 100px;">
                            <div class="fs-9 text-muted mt-1">Tự động hủy ngay sau khi quẹt</div>
                        </div>
                        <button class="btn btn-xs btn-outline-primary w-100 rounded-pill" onclick="sharePass('Shipper', '#4902')">
                            <i class="bi bi-share me-1"></i> Gửi link mã qua Zalo / SMS
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL TẠO VÉ KHÁCH MỚI ================= -->
<div class="modal fade" id="modalCreatePass" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <h5 class="modal-title fw-bold text-slate-900">Tạo Mã Vé Khách Ghé Thăm Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createPassForm" onsubmit="handleCreatePass(event)">
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Tên khách ghé thăm hoặc đơn vị</label>
                        <input type="text" id="gpName" class="form-control rounded-3" placeholder="Ví dụ: Nguyễn Văn Cường (Bạn thân)" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Số điện thoại khách (Không bắt buộc)</label>
                        <input type="text" id="gpPhone" class="form-control rounded-3" placeholder="0912xxxxxx">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Thời hạn hiệu lực của vé</label>
                        <select id="gpDuration" class="form-select rounded-3">
                            <option value="2 giờ">2 giờ (Dành cho bạn bè ghé chơi ngắn)</option>
                            <option value="1 lần duy nhất">1 lần duy nhất (Dành cho Shipper/Giao đồ)</option>
                            <option value="Trong ngày (Hết 23:59)">Trong ngày (Hết hạn lúc 23:59 đêm nay)</option>
                            <option value="3 ngày cuối tuần">3 ngày cuối tuần (Dành cho người nhà ở lại)</option>
                        </select>
                    </div>
                    <div class="modal-footer px-0 pb-0 pt-3 border-0">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                            <i class="bi bi-qr-code me-1"></i> Tạo Vé & Sinh Mã QR
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function sendUnlockSignal() {
        showPassAlert('Đã gửi lệnh mở khóa qua giao thức MQTT tới khóa phòng P.305! Cửa đã được mở thành công.');
    }

    function revokePass(id, name) {
        if (confirm(`Bạn có chắc chắn muốn thu hồi mã khách của [${name}]? Mã sẽ bị vô hiệu hóa ngay lập tức.`)) {
            document.getElementById(id).remove();
            showPassAlert(`Đã hủy vé của [${name}] thành công! Cổng sảnh sẽ từ chối mã này.`);
        }
    }

    function sharePass(name, pin) {
        prompt(`Sao chép đường link gửi cho [${name}]:`, `https://smartstay.vn/pass?room=P305&pin=${pin.replace('#', '')}&token=SECURE_${Date.now()}`);
        showPassAlert(`Đã tạo link chia sẻ vé khách cho [${name}].`);
    }

    function handleCreatePass(e) {
        e.preventDefault();
        const name = document.getElementById('gpName').value;
        const duration = document.getElementById('gpDuration').value;
        const randomPin = `#${Math.floor(1000 + Math.random() * 9000)}`;
        const passId = `pass-${Date.now()}`;

        const newPassCard = `
            <div class="col-md-6" id="${passId}">
                <div class="p-3 rounded-3 bg-light border position-relative h-100 border-primary-subtle shadow-sm">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-primary text-white fs-9">${duration}</span>
                            <h6 class="fw-bold mb-0 mt-1">${name}</h6>
                        </div>
                        <button class="btn btn-xs btn-outline-danger rounded-pill" onclick="revokePass('${passId}', '${name}')">
                            <i class="bi bi-x-circle"></i> Hủy vé
                        </button>
                    </div>
                    <div class="fs-8 text-muted mb-2">Mã PIN cửa sảnh: <strong class="text-primary fs-6">${randomPin}</strong></div>
                    <div class="text-center p-2 rounded-2 bg-white border mb-2">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=SMARTSTAY_GUEST_${randomPin}" alt="QR Pass" class="img-fluid" style="width: 100px; height: 100px;">
                        <div class="fs-9 text-muted mt-1">Quét tại đầu đọc RFID sảnh A</div>
                    </div>
                    <button class="btn btn-xs btn-outline-primary w-100 rounded-pill" onclick="sharePass('${name}', '${randomPin}')">
                        <i class="bi bi-share me-1"></i> Gửi link mã qua Zalo / SMS
                    </button>
                </div>
            </div>
        `;

        document.getElementById('activePassList').insertAdjacentHTML('afterbegin', newPassCard);
        bootstrap.Modal.getInstance(document.getElementById('modalCreatePass')).hide();
        showPassAlert(`Đã tạo thành công vé khách cho [${name}] với mã PIN ${randomPin}!`);
    }

    function showPassAlert(msg) {
        const box = document.getElementById('passAlert');
        document.getElementById('passAlertText').innerText = msg;
        box.classList.remove('d-none');
        box.classList.add('show');
        setTimeout(() => {
            box.classList.remove('show');
            box.classList.add('d-none');
        }, 5000);
    }
</script>
