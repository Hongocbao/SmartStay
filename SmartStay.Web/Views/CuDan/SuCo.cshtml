@{
    ViewData["Title"] = "Báo Cáo Sự Cố & Tiến Độ Sửa Chữa";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h6 class="fw-bold mb-1 text-slate-900"><i class="bi bi-tools text-primary me-2"></i>Theo Dõi Tiến Độ Sửa Chữa (Phòng P.305)</h6>
            <p class="fs-8 text-muted mb-0">Các yêu cầu hỏng hóc thiết bị, điện nước, khóa từ được xử lý theo quy trình Kanban.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#newTicketModal">
            <i class="bi bi-plus-lg me-1"></i> Báo Hỏng Thiết Bị Mới
        </button>
    </div>
</div>

<!-- Danh sách phiếu sự cố -->
<div class="row g-4">
    <!-- Phiếu 1: Đang sửa chữa -->
    <div class="col-lg-6">
        <div class="card-custom h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-warning-subtle text-warning fw-bold fs-8">
                    <i class="bi bi-gear-wide-connected me-1"></i> ĐANG SỬA CHỮA
                </span>
                <span class="fs-9 text-muted">Mã phiếu: <strong>SC-2026-0305-01</strong></span>
            </div>

            <h5 class="fw-bold text-slate-900 mb-2">Máy lạnh kêu to và rỉ nước máng xả</h5>
            <p class="fs-8 text-muted mb-3">
                Máy lạnh phòng P.305 bật chế độ Cool 26°C thì phát tiếng rè rè liên tục, máng thoát nước bị nghẹt gây rỉ giọt xuống sàn gỗ.
            </p>

            <div class="bg-light p-3 rounded-3 border mb-3 fs-8">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Danh mục:</span>
                    <strong class="text-primary">Máy lạnh / Điều hòa</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Mức độ ưu tiên:</span>
                    <span class="badge bg-danger-subtle text-danger">Cao (SLA: 24h)</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Kỹ thuật viên phụ trách:</span>
                    <strong>Trần Văn Tuấn (KTV Tòa nhà)</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Thời điểm gửi:</span>
                    <span>29/10/2026 14:30</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 text-warning fs-8 fw-semibold">
                <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                Kỹ thuật viên đã mang ống thoát nước mới và đang xử lý tại phòng.
            </div>
        </div>
    </div>

    <!-- Phiếu 2: Đã hoàn thành nghiệm thu -->
    <div class="col-lg-6">
        <div class="card-custom h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-success-subtle text-success fw-bold fs-8">
                    <i class="bi bi-check-circle-fill me-1"></i> ĐÃ HOÀN THÀNH
                </span>
                <span class="fs-9 text-muted">Mã phiếu: <strong>SC-2026-0305-00</strong></span>
            </div>

            <h5 class="fw-bold text-slate-900 mb-2">Thay bóng đèn LED khu vực bàn làm việc</h5>
            <p class="fs-8 text-muted mb-3">
                Bóng đèn trần khu vực bàn học bị chớp nháy liên tục không sáng được.
            </p>

            <div class="bg-light p-3 rounded-3 border mb-3 fs-8">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Danh mục:</span>
                    <strong class="text-primary">Điện chiếu sáng</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Vật tư xuất kho:</span>
                    <span>1 Bóng LED Rạng Đông 12W (Miễn phí bảo hành)</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">KTV hoàn thành:</span>
                    <strong>Trần Văn Tuấn</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Thời điểm nghiệm thu:</span>
                    <span class="text-success fw-bold">15/10/2026 16:45</span>
                </div>
            </div>

            <div class="text-success fs-8 fw-semibold">
                <i class="bi bi-patch-check-fill me-1"></i> Nghiệm thu hoàn tất - Cư dân đã ký nhận bàn giao.
            </div>
        </div>
    </div>
</div>

<!-- Modal Báo Sự Cố Mới -->
<div class="modal fade" id="newTicketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form action="/CuDan/GuiYeuCauSuCo" method="post">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold"><i class="bi bi-tools text-warning me-2"></i>Báo Cáo Hỏng Hóc / Sự Cố</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Danh mục thiết bị: *</label>
                        <select class="form-select" name="danhMuc" required>
                            <option value="Máy lạnh">Máy lạnh / Điều hòa</option>
                            <option value="Điện">Điện & Đèn chiếu sáng</option>
                            <option value="Nước">Đường ống nước & Vòi sen</option>
                            <option value="Khóa từ">Khóa thông minh IoT / Thẻ từ</option>
                            <option value="Nội thất">Giường, Tủ, Bàn ghế</option>
                            <option value="Khác">Vấn đề khác</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Mức độ khẩn cấp: *</label>
                        <select class="form-select" name="mucDoUuTien" required>
                            <option value="Trung bình">Trung bình (Xử lý trong 24h)</option>
                            <option value="Khẩn cấp">Khẩn cấp (Chập điện, vỡ ống nước - Xử lý ngay)</option>
                            <option value="Thấp">Thấp (Trong 48h)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Mô tả hiện tượng hư hỏng: *</label>
                        <textarea class="form-control" name="moTa" rows="3" placeholder="Nhập chi tiết hiện tượng hư hỏng để KTV chuẩn bị linh kiện thay thế..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">Gửi yêu cầu sửa chữa</button>
                </div>
            </form>
        </div>
    </div>
</div>
