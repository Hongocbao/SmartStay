@{
    ViewData["Title"] = "Chia Tiền Phòng Ở Ghép & Đa Mã VietQR Động - SmartStay";
}

<!-- Alert thông báo -->
<div id="splitAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm mb-4" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="splitAlertText">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('splitAlert').classList.add('d-none')"></button>
</div>

<!-- Header -->
<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary text-white px-2 py-1 fs-9 rounded-pill">ĐỘT PHÁ UX</span>
                <span class="badge bg-success-subtle text-success border px-2 py-1 fs-9 rounded-pill">Co-Living Split-Bill</span>
            </div>
            <h4 class="fw-bold mb-1 text-slate-900"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Chia Tiền Phòng Ở Ghép & Đa Mã VietQR Riêng Từng Thành Viên</h4>
            <p class="text-muted fs-8 mb-0">Tự động bóc tách hóa đơn tổng phòng P.305, sinh mã QR VietQR riêng cho từng bạn cùng phòng kèm thanh tiến độ thanh toán thời gian thực</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-sm btn-dark rounded-3 shadow-sm" onclick="openQrScannerModal(2)">
                <i class="bi bi-qr-code-scan text-info me-1"></i> Mở Máy Quét QR Nội Khu (Quét Thử QR)
            </button>
            <button class="btn btn-sm btn-outline-primary rounded-3" onclick="recalcSplitBills()">
                <i class="bi bi-arrow-clockwise me-1"></i> Tính lại tiền
            </button>
            <button class="btn btn-sm btn-primary rounded-3 shadow-sm" onclick="sendReminderAll()">
                <i class="bi bi-bell-fill me-1"></i> Nhắc nhở cả phòng nộp tiền
            </button>
        </div>
    </div>
</div>

<!-- Thống kê tổng hóa đơn phòng -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card-custom h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-slate-800 mb-0">HÓA ĐƠN THÁNG 10/2026 - PHÒNG P.305 (3 THÀNH VIÊN Ở GHÉP)</h6>
                <span class="badge bg-primary-subtle text-primary fs-8">HĐ-2026-10-305</span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3 col-6">
                    <div class="p-3 rounded-3 bg-light text-center border">
                        <div class="text-muted fs-8 mb-1">Tiền phòng cố định</div>
                        <div class="fw-bold text-slate-900 fs-7">3.500.000 đ</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 rounded-3 bg-light text-center border">
                        <div class="text-muted fs-8 mb-1">Điện (120 kWh)</div>
                        <div class="fw-bold text-primary fs-7">254.000 đ</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 rounded-3 bg-light text-center border">
                        <div class="text-muted fs-8 mb-1">Nước (8 m³)</div>
                        <div class="fw-bold text-info fs-7">105.000 đ</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-3 rounded-3 bg-light text-center border">
                        <div class="text-muted fs-8 mb-1">Dịch vụ chung</div>
                        <div class="fw-bold text-secondary fs-7">300.000 đ</div>
                    </div>
                </div>
            </div>

            <!-- Thanh tiến độ đóng tiền phòng -->
            <div class="p-3 rounded-3 bg-light border mb-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fs-8 fw-bold text-slate-800">TIẾN ĐỘ HOÀN TẤT HÓA ĐƠN PHÒNG P.305:</span>
                    <span class="fw-bold fs-7 text-primary" id="progressText">2 / 3 Bạn đã thanh toán (66.7%)</span>
                </div>
                <div class="progress" style="height: 12px; border-radius: 8px;">
                    <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" role="progressbar" id="progressBar" style="width: 66.7%;"></div>
                </div>
                <div class="d-flex justify-content-between text-muted fs-9 mt-2">
                    <span>Đã thu: <strong class="text-success" id="collectedAmount">2.772.666 đ</strong></span>
                    <span>Tổng hóa đơn: <strong class="text-danger">4.159.000 đ</strong></span>
                    <span>Còn thiếu: <strong class="text-warning" id="remainingAmount">1.386.334 đ</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cài đặt cách chia -->
    <div class="col-lg-4">
        <div class="card-custom h-100">
            <h6 class="fw-bold text-slate-800 mb-3"><i class="bi bi-sliders2 text-primary me-2"></i>Thiết Lập Cách Chia</h6>
            <div class="mb-3">
                <label class="form-label fw-semibold fs-8">Phương thức phân bổ tiền</label>
                <select class="form-select form-select-sm rounded-3" id="splitMethod" onchange="changeSplitMethod(this.value)">
                    <option value="equal" selected>Chia đều 3 người (Mỗi bạn 1/3)</option>
                    <option value="days">Chia theo số ngày ở thực tế</option>
                    <option value="custom">Tùy chỉnh tỷ lệ cá nhân</option>
                </select>
            </div>
            <div class="alert alert-info py-2 px-3 fs-9 border-0 rounded-3 mb-3">
                <i class="bi bi-info-circle me-1"></i> Hệ thống tự động tạo mã VietQR NAPAS 247 riêng biệt gắn chính xác số tiền lẻ và mã định danh của từng bạn.
            </div>
            <div class="p-2 rounded-2 bg-light border fs-8 text-center">
                Mỗi bạn đóng: <strong class="text-danger fs-6" id="eachAmount">1.386.333 đ</strong>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách 3 thành viên & 3 Mã VietQR Động Riêng Biệt -->
<div class="row g-4">
    <!-- Thành viên 1: Hồ Ngọc Bảo (Trưởng phòng) -->
    <div class="col-lg-4">
        <div class="card-custom h-100 border border-success-subtle shadow-sm">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-primary text-white fs-9 mb-1">Trưởng phòng</span>
                    <h5 class="fw-bold text-slate-900 mb-0">Hồ Ngọc Bảo</h5>
                    <span class="text-muted fs-8">MSSV: 2380600133</span>
                </div>
                <span class="badge bg-success text-white py-1 px-2" id="badge-user1"><i class="bi bi-check-circle me-1"></i> Đã nộp</span>
            </div>

            <div class="p-3 rounded-3 bg-light border text-center mb-3">
                <div class="text-muted fs-8">Số tiền cần đóng:</div>
                <div class="fw-bold fs-5 text-success" id="amount-user1">1.386.333 đ</div>
                <div class="fs-9 text-muted mt-1">Cú pháp: <code>HD1026 P305 BAO1</code></div>
                <div class="fs-9 text-primary fw-bold mt-1" id="sub-user1">Chia đều: 1/3 hóa đơn</div>
            </div>

            <!-- Mã QR Sandbox Định Danh Ảo của Bảo 1 -->
            <div class="text-center p-3 rounded-3 bg-white border mb-3" style="cursor:pointer;" onclick="openQrScannerModal(0)" title="Bấm để mở Máy Quét QR Nội Khu">
