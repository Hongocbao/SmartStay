                <div class="fs-9 text-success mt-2 fw-semibold"><i class="bi bi-shield-lock-fill"></i> TK Định danh Ảo: VA-P305-BAO1 (Bấm vào QR để Quét Thử)</div>
            </div>

            <button class="btn btn-sm btn-outline-success w-100 rounded-3" onclick="openQrScannerModal(0)">
                <i class="bi bi-qr-code-scan me-1"></i> Xem Kết Quả Quét QR (Đã Đối Soát)
            </button>
        </div>
    </div>

    <!-- Thành viên 2: Nguyễn Dương Bảo -->
    <div class="col-lg-4">
        <div class="card-custom h-100 border border-success-subtle shadow-sm">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-secondary-subtle text-secondary fs-9 mb-1">Thành viên 2</span>
                    <h5 class="fw-bold text-slate-900 mb-0">Nguyễn Dương Bảo</h5>
                    <span class="text-muted fs-8">MSSV: 2380600154</span>
                </div>
                <span class="badge bg-success text-white py-1 px-2" id="badge-user2"><i class="bi bi-check-circle me-1"></i> Đã nộp</span>
            </div>

            <div class="p-3 rounded-3 bg-light border text-center mb-3">
                <div class="text-muted fs-8">Số tiền cần đóng:</div>
                <div class="fw-bold fs-5 text-success" id="amount-user2">1.386.333 đ</div>
                <div class="fs-9 text-muted mt-1">Cú pháp: <code>HD1026 P305 BAO2</code></div>
                <div class="fs-9 text-primary fw-bold mt-1" id="sub-user2">Chia đều: 1/3 hóa đơn</div>
            </div>

            <!-- Mã QR Sandbox Định Danh Ảo của Bảo 2 -->
            <div class="text-center p-3 rounded-3 bg-white border mb-3" style="cursor:pointer;" onclick="openQrScannerModal(1)" title="Bấm để mở Máy Quét QR Nội Khu">
                <img id="qr-user2" src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&color=1E3A8A&data=SMARTSTAY_SANDBOX_PAY|VA:VA-P305-BAO2|AMOUNT:1386333|DEMO_SAFE" alt="QR Dương Bảo" class="img-fluid rounded border p-2" style="max-height: 170px;">
                <div class="fs-9 text-success mt-2 fw-semibold"><i class="bi bi-shield-lock-fill"></i> TK Định danh Ảo: VA-P305-BAO2 (Bấm vào QR để Quét Thử)</div>
            </div>

            <button class="btn btn-sm btn-outline-success w-100 rounded-3" onclick="openQrScannerModal(1)">
                <i class="bi bi-qr-code-scan me-1"></i> Xem Kết Quả Quét QR (Đã Đối Soát)
            </button>
        </div>
    </div>

    <!-- Thành viên 3: Trần Hoàng Gia Bảo (Chưa nộp) -->
    <div class="col-lg-4">
        <div class="card-custom h-100 border border-warning shadow-sm" id="card-user3" style="background: #FFFDF5;">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-secondary-subtle text-secondary fs-9 mb-1">Thành viên 3</span>
                    <h5 class="fw-bold text-slate-900 mb-0">Trần Hoàng Gia Bảo</h5>
                    <span class="text-muted fs-8">MSSV: 2380600178</span>
                </div>
                <span class="badge bg-warning text-dark py-1 px-2" id="badge-user3"><i class="bi bi-clock-history me-1"></i> Chưa nộp</span>
            </div>

            <div class="p-3 rounded-3 bg-light border text-center mb-3">
                <div class="text-muted fs-8">Số tiền cần đóng:</div>
                <div class="fw-bold fs-5 text-danger" id="amount-user3">1.386.334 đ</div>
                <div class="fs-9 text-muted mt-1">Cú pháp: <code>HD1026 P305 BAO3</code></div>
                <div class="fs-9 text-primary fw-bold mt-1" id="sub-user3">Chia đều: 1/3 hóa đơn</div>
            </div>

            <!-- Mã QR Sandbox Định Danh Ảo của Bảo 3 -->
            <div class="text-center p-3 rounded-3 bg-white border mb-3" style="cursor:pointer;" onclick="openQrScannerModal(2)" title="Bấm để mở Máy Quét QR Nội Khu">
                <img id="qr-user3" src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&color=1E3A8A&data=SMARTSTAY_SANDBOX_PAY|VA:VA-P305-BAO3|AMOUNT:1386334|DEMO_SAFE" alt="QR Gia Bảo" class="img-fluid rounded border p-2" style="max-height: 170px;">
                <div class="fs-9 text-primary mt-2 fw-semibold"><i class="bi bi-qr-code-scan"></i> Bấm vào mã QR để mở Máy Quét QR Sandbox Nội Khu</div>
            </div>

            <button class="btn btn-sm btn-success w-100 rounded-3 shadow-sm" id="btn-pay-user3" onclick="openQrScannerModal(2)">
                <i class="bi bi-qr-code-scan me-1"></i> Quét QR & Thanh Toán Sandbox 1 Chạm
            </button>
        </div>
    </div>
</div>

<!-- ================= MODAL MÁY QUÉT QR SANDBOX NỘI KHU ================= -->
<div class="modal fade" id="modalQrScanner" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom px-4 pt-3 pb-2 bg-dark text-white rounded-top-4">
                <div>
                    <h6 class="modal-title fw-bold mb-0"><i class="bi bi-qr-code-scan text-info me-2"></i>Máy Quét QR Nội Khu SmartStay Sandbox</h6>
                    <div class="fs-9 text-white-50">Trình giả lập Camera đọc & giải mã QR Token trực tiếp trên Web/App</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Chọn nhanh QR cần đưa vào ống kính -->
                <div class="mb-3">
                    <label class="form-label fs-9 fw-bold text-muted mb-1">CHỌN MÃ QR ĐƯA VÀO ỐNG KÍNH QUÉT:</label>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-xs btn-outline-primary flex-fill" onclick="loadQrIntoScanner(0)">QR Hồ Ngọc Bảo</button>
                        <button type="button" class="btn btn-xs btn-outline-primary flex-fill" onclick="loadQrIntoScanner(1)">QR Dương Bảo</button>
                        <button type="button" class="btn btn-xs btn-primary flex-fill" onclick="loadQrIntoScanner(2)">QR Gia Bảo</button>
                    </div>
                </div>

                <!-- Khung kính ngắm Laser -->
                <div class="p-3 rounded-4 text-center position-relative mb-3" style="background: #0F172A;">
                    <div class="d-inline-block p-2 bg-white rounded-3 position-relative" id="scannerFrameBorder" style="border: 3px solid #38BDF8;">
                        <img id="scannerQrImg" src="" alt="QR Scan" style="width: 165px; height: 165px;">
                        <div id="scannerLaser" style="position:absolute; left:0; right:0; top:50%; height:3px; background:#EF4444; box-shadow: 0 0 10px 2px #EF4444;"></div>
                    </div>
                    <div class="mt-2">
                        <span id="scannerStatusBadge" class="badge bg-info text-dark px-3 py-1 rounded-pill fs-9">
                            ⚡ Đang quét tia Laser & giải mã dữ liệu QR...
                        </span>
                    </div>
                </div>

                <!-- Kết quả giải mã -->
                <div class="p-3 rounded-3 bg-light border mb-3 fs-8">
                    <div class="fw-bold text-primary mb-2"><i class="bi bi-cpu-fill me-1"></i>DỮ LIỆU GIẢI MÃ TỪ MÃ QR (DECODED PAYLOAD):</div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Chuẩn mã hóa:</span>
                        <strong class="text-slate-900">SMARTSTAY_SANDBOX_PAY (NAPAS 247)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Tài khoản Định danh Ảo (VA):</span>
                        <strong class="text-success" id="scanVaCode">VA-P305-BAO3</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Thành viên thanh toán:</span>
                        <strong class="text-slate-900" id="scanMemberName">Trần Hoàng Gia Bảo</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted">Số tiền giải mã:</span>
                        <strong class="text-danger fs-7" id="scanAmount">1.386.334 đ</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Nội dung đối soát:</span>
                        <code id="scanSyntax">HD1026 P305 BAO3</code>
                    </div>
                </div>

                <button type="button" id="btnConfirmScannedQr" class="btn btn-success w-100 rounded-3 fw-bold py-2 shadow-sm" onclick="confirmScannedQrPayment()">
                    <i class="bi bi-check2-circle me-1"></i> XÁC NHẬN THANH TOÁN QUA MÃ QR VỪA QUÉT
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentScannedIndex = 2;
    let user3Paid = false;

    function openQrScannerModal(idx) {
        const modalEl = document.getElementById('modalQrScanner');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
        loadQrIntoScanner(idx);
    }

    function loadQrIntoScanner(idx) {
        currentScannedIndex = idx;
        const members = [
            { name: 'Hồ Ngọc Bảo (Trưởng phòng)', va: 'VA-P305-BAO1', syntax: 'HD1026 P305 BAO1', amountId: 'amount-user1', qrId: 'qr-user1', paid: true },
            { name: 'Nguyễn Dương Bảo', va: 'VA-P305-BAO2', syntax: 'HD1026 P305 BAO2', amountId: 'amount-user2', qrId: 'qr-user2', paid: true },
            { name: 'Trần Hoàng Gia Bảo', va: 'VA-P305-BAO3', syntax: 'HD1026 P305 BAO3', amountId: 'amount-user3', qrId: 'qr-user3', paid: user3Paid }
        ];
        const m = members[idx];
        document.getElementById('scannerQrImg').src = document.getElementById(m.qrId).src;
        document.getElementById('scanVaCode').innerText = m.va;
        document.getElementById('scanMemberName').innerText = m.name;
        document.getElementById('scanAmount').innerText = document.getElementById(m.amountId).innerText;
        document.getElementById('scanSyntax').innerText = m.syntax;

        // Hiệu ứng quét Laser 600ms
        document.getElementById('scannerLaser').style.display = 'block';
        document.getElementById('scannerFrameBorder').style.borderColor = '#38BDF8';
        document.getElementById('scannerStatusBadge').className = 'badge bg-info text-dark px-3 py-1 rounded-pill fs-9';
        document.getElementById('scannerStatusBadge').innerText = '⚡ Đang quét tia Laser & giải mã dữ liệu QR...';

        setTimeout(() => {
            document.getElementById('scannerLaser').style.display = 'none';
            document.getElementById('scannerFrameBorder').style.borderColor = '#10B981';
            document.getElementById('scannerStatusBadge').className = 'badge bg-success text-white px-3 py-1 rounded-pill fs-9';
            document.getElementById('scannerStatusBadge').innerText = '✓ ĐÃ QUÉT & GIẢI MÃ THÀNH CÔNG QR TOKEN';
        }, 600);

        const btn = document.getElementById('btnConfirmScannedQr');
        if (m.paid) {
            btn.className = 'btn btn-outline-success w-100 rounded-3 fw-bold py-2';
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-patch-check-fill me-1"></i> MÃ QR NÀY ĐÃ ĐỐI SOÁT THANH TOÁN';
        } else {
            btn.className = 'btn btn-success w-100 rounded-3 fw-bold py-2 shadow-sm';
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> XÁC NHẬN THANH TOÁN QUA MÃ QR VỪA QUÉT';
        }
    }

    function confirmScannedQrPayment() {
        bootstrap.Modal.getInstance(document.getElementById('modalQrScanner')).hide();
        simulatePayUser3();
    }

    function simulatePayUser3() {
        user3Paid = true;
        document.getElementById('badge-user3').className = 'badge bg-success text-white py-1 px-2';
        document.getElementById('badge-user3').innerHTML = '<i class="bi bi-check-circle me-1"></i> Đã nộp';
        document.getElementById('card-user3').style.background = '#FFFFFF';
        document.getElementById('card-user3').className = 'card-custom h-100 border border-success-subtle shadow-sm';
        
        document.getElementById('btn-pay-user3').className = 'btn btn-sm btn-outline-success w-100 rounded-3';
        document.getElementById('btn-pay-user3').disabled = true;
        document.getElementById('btn-pay-user3').innerHTML = '<i class="bi bi-patch-check-fill me-1"></i> Đã Đối Soát Thành Công';

        // Cập nhật thanh tiến độ 100%
        document.getElementById('progressBar').style.width = '100%';
        document.getElementById('progressText').innerText = '3 / 3 Bạn đã thanh toán hoàn tất (100%)';
        document.getElementById('progressText').className = 'fw-bold fs-7 text-success';
        document.getElementById('collectedAmount').innerText = '4.159.000 đ';
        document.getElementById('remainingAmount').innerText = '0 đ';

        showSplitAlert('Ngân hàng báo có: Trần Hoàng Gia Bảo đã chuyển khoản 1.386.334 đ qua VietQR Napas 247! Hóa đơn phòng P.305 đã hoàn tất 100%.');
    }

    function recalcSplitBills() {
        showSplitAlert('Đã tính toán lại công thức chia tiền điện nước và tiền phòng theo quy chế Co-Living 2026.');
    }

    function sendReminderAll() {
        showSplitAlert('Đã gửi thông báo nhắc nợ Push Notification và Email kèm link VietQR cá nhân tới Trần Hoàng Gia Bảo!');
    }

    function changeSplitMethod(val) {
        const total = 4159000;
        const fixedCost = 3800000; // Tiền phòng 3.5tr + Dịch vụ chung 300k chia đều
        const utilCost = 359000;   // Điện 254k + Nước 105k chia theo ngày ở thực tế
        let a1 = 1386333, a2 = 1386333, a3 = 1386334;

        if (val === 'days') {
            // Bảo 1 (30 ngày), Bảo 2 (28 ngày), Bảo 3 (20 ngày - về quê thực tập) -> Tổng 78 ngày
            const fixedEach = fixedCost / 3;
            a1 = Math.round(fixedEach + utilCost * (30 / 78));
            a2 = Math.round(fixedEach + utilCost * (28 / 78));
            a3 = total - a1 - a2;
            document.getElementById('sub-user1').innerText = 'Ở thực tế: 30/30 ngày';
            document.getElementById('sub-user2').innerText = 'Ở thực tế: 28/30 ngày';
            document.getElementById('sub-user3').innerText = 'Ở thực tế: 20/30 ngày (Về quê 10 ngày)';
            showSplitAlert('Đã chuyển sang chia theo số ngày ở thực tế: Tiền phòng chia đều, riêng Tiền Điện + Nước chia theo số ngày ở (Bảo 1: 30 ngày, Bảo 2: 28 ngày, Bảo 3: 20 ngày).');
        } else if (val === 'custom') {
            a1 = Math.round(total * 0.40);
            a2 = Math.round(total * 0.30);
            a3 = total - a1 - a2;
            document.getElementById('sub-user1').innerText = 'Tỷ lệ thỏa thuận: 40%';
            document.getElementById('sub-user2').innerText = 'Tỷ lệ thỏa thuận: 30%';
            document.getElementById('sub-user3').innerText = 'Tỷ lệ thỏa thuận: 30%';
            showSplitAlert('Đã chuyển sang chia theo tỷ lệ thỏa thuận cá nhân (40% - 30% - 30%).');
        } else {
            document.getElementById('sub-user1').innerText = 'Chia đều: 1/3 hóa đơn';
            document.getElementById('sub-user2').innerText = 'Chia đều: 1/3 hóa đơn';
            document.getElementById('sub-user3').innerText = 'Chia đều: 1/3 hóa đơn';
            showSplitAlert('Đã chuyển sang chế độ chia đều 3 thành viên trong phòng (1/3 tổng chi phí).');
        }

        const fmt = (n) => n.toLocaleString('vi-VN') + ' đ';
        document.getElementById('amount-user1').innerText = fmt(a1);
        document.getElementById('amount-user2').innerText = fmt(a2);
        document.getElementById('amount-user3').innerText = fmt(a3);
        document.getElementById('collectedAmount').innerText = fmt(a1 + a2);
        document.getElementById('remainingAmount').innerText = fmt(a3);
        document.getElementById('qr-user1').src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&color=1E3A8A&data=SMARTSTAY_SANDBOX_PAY|VA:VA-P305-BAO1|AMOUNT:${a1}|DEMO_SAFE`;
        document.getElementById('qr-user2').src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&color=1E3A8A&data=SMARTSTAY_SANDBOX_PAY|VA:VA-P305-BAO2|AMOUNT:${a2}|DEMO_SAFE`;
        document.getElementById('qr-user3').src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&color=1E3A8A&data=SMARTSTAY_SANDBOX_PAY|VA:VA-P305-BAO3|AMOUNT:${a3}|DEMO_SAFE`;
    }

    function showSplitAlert(msg) {
        const box = document.getElementById('splitAlert');
        document.getElementById('splitAlertText').innerText = msg;
        box.classList.remove('d-none');
        box.classList.add('show');
        setTimeout(() => {
            box.classList.remove('show');
            box.classList.add('d-none');
        }, 5000);
    }
</script>
