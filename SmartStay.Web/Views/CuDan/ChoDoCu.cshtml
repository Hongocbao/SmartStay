@{
    ViewData["Title"] = "Chợ Trao Đổi Đồ Cũ Sinh Viên Co-Living - SmartStay";
}

<!-- Alert thông báo -->
<div id="ecoAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm mb-4" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="ecoAlertText">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('ecoAlert').classList.add('d-none')"></button>
</div>

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success text-white px-2 py-1 fs-9 rounded-pill">ECO-COMMUNITY</span>
                <span class="badge bg-primary-subtle text-primary border px-2 py-1 fs-9 rounded-pill">Nội Khu Co-Living</span>
            </div>
            <h4 class="fw-bold mb-1 text-slate-900"><i class="bi bi-recycle text-success me-2"></i>Sàn Trao Đổi Đồ Dùng & Đồ Cũ Sinh Viên (Eco-Marketplace)</h4>
            <p class="text-muted fs-8 mb-0">Nơi cư dân các phòng pass lại đồ gia dụng, bàn học, quạt, giáo trình còn mới với giá rẻ hoặc tặng miễn phí (0đ). 100% người bán là cư dân đã xác minh</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalPostItem">
                <i class="bi bi-plus-lg me-1"></i> Đăng Bán / Tặng Đồ Cũ
            </button>
        </div>
    </div>
</div>

<!-- Bộ lọc danh mục -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <button id="ecoFilterAll" class="btn btn-sm btn-outline-secondary rounded-pill active eco-filter-btn" onclick="filterEco('all', this)">Tất cả (<span id="ecoTotalCount">6</span> món)</button>
    <button class="btn btn-sm btn-outline-success rounded-pill eco-filter-btn" onclick="filterEco('free', this)">🎁 Tặng miễn phí (0đ)</button>
    <button class="btn btn-sm btn-outline-primary rounded-pill eco-filter-btn" onclick="filterEco('electronics', this)">Thiết bị điện gia dụng</button>
    <button class="btn btn-sm btn-outline-warning rounded-pill eco-filter-btn" onclick="filterEco('study', this)">Bàn ghế &amp; Giáo trình</button>
</div>

<!-- Lưới sản phẩm đồ cũ -->
<div class="row g-4" id="ecoGrid">
    <div class="col-12 text-center py-4 text-muted">
        <div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang tải danh sách đồ cũ &amp; đánh giá từ hệ thống...
    </div>
</div>

<!-- ================= MODAL ĐĂNG ĐỒ CŨ (ẢNH + VIDEO) ================= -->
<div class="modal fade" id="modalPostItem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-3 pb-2">
                <h5 class="modal-title fw-bold text-slate-900"><i class="bi bi-camera-reels text-primary me-2"></i>Đăng Đồ Cũ Kèm Ảnh &amp; Video Thực Tế</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="postItemForm" onsubmit="handlePostItem(event)">
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Tên đồ dùng cần pass *</label>
                        <input type="text" id="piTitle" class="form-control rounded-3" placeholder="Ví dụ: Bàn học gấp gọn thông minh" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Danh mục</label>
                            <select id="piCategory" class="form-select rounded-3">
                                <option value="electronics">Đồ điện gia dụng</option>
                                <option value="study">Bàn ghế &amp; Giáo trình</option>
                                <option value="free">Tặng miễn phí (0đ)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Giá thanh lý (VNĐ)</label>
                            <input type="text" id="piPrice" class="form-control rounded-3" value="150000" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Mô tả tình trạng món đồ *</label>
                        <textarea id="piDesc" class="form-control rounded-3" rows="2" placeholder="Mô tả độ mới, thời gian sử dụng, lý do thanh lý..." required></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 bg-light h-100">
                                <label class="form-label fw-bold small mb-2"><i class="bi bi-image text-success me-1"></i>Ảnh chụp thực tế</label>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <label class="btn btn-sm btn-outline-primary rounded-3 mb-0" style="cursor:pointer;">
                                        <i class="bi bi-upload me-1"></i> Chọn / Chụp ảnh
                                        <input type="file" id="piImageInput" accept="image/*" capture="environment" class="d-none" onchange="onEcoImageSelected(this)">
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" onclick="clearEcoImage()">Xóa ảnh</button>
                                </div>
                                <img id="piImagePreview" src="" alt="Preview" class="w-100 rounded-3 border d-none" style="height: 130px; object-fit: cover;">
                                <div id="piImageHint" class="text-muted small">Hỗ trợ chụp trực tiếp bằng camera điện thoại hoặc tải ảnh từ máy.</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="border rounded-3 p-3 bg-light h-100">
                                <label class="form-label fw-bold small mb-2"><i class="bi bi-camera-video text-danger me-1"></i>Video quay thực tế món đồ</label>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <label class="btn btn-sm btn-outline-danger rounded-3 mb-0" style="cursor:pointer;">
                                        <i class="bi bi-film me-1"></i> Tải Video lên
                                        <input type="file" id="piVideoInput" accept="video/*" capture="environment" class="d-none" onchange="onEcoVideoSelected(this)">
                                    </label>
                                    <button type="button" id="piRecordVideoBtn" class="btn btn-sm btn-danger rounded-3" onclick="recordEcoVideo5s()">
                                        <i class="bi bi-record-circle me-1"></i> Quay trực tiếp (4s)
                                    </button>
                                </div>
                                <video id="piVideoPreview" class="w-100 rounded-3 border d-none" style="height: 130px; background:#000;" controls muted playsinline></video>
                                <div id="piVideoStatus" class="text-muted small">Quay nhanh video kiểm tra hoạt động hoặc tải video có sẵn.</div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer px-0 pb-0 pt-3 border-0 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="piSubmitBtn" class="btn btn-success rounded-3 px-4 fw-semibold shadow-sm">
                            <i class="bi bi-tag-fill me-1"></i> Đăng Lên Chợ Cư Dân
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL ĐÁNH GIÁ & BÌNH LUẬN CHI TIẾT ================= -->
<div class="modal fade" id="modalItemReview" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-3 pb-2">
                <div>
                    <h5 class="modal-title fw-bold text-slate-900 mb-0"><i class="bi bi-star-fill text-warning me-2"></i>Đánh Giá &amp; Bình Luận Chi Tiết</h5>
                    <small class="text-muted" id="rvItemSubtitle">Sản phẩm nội khu SmartStay</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="rvExistingList" class="d-flex flex-column gap-2 mb-4" style="max-height: 220px; overflow-y: auto;"></div>

                <form id="rvReviewForm" onsubmit="submitEcoReview(event)" class="border-top pt-3">
                    <input type="hidden" id="rvMaTin">
                    <input type="hidden" id="rvTieuDeFallback">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <span class="fw-semibold small">Chọn số sao hài lòng:</span>
                        <div class="d-flex gap-1" id="rvStarPicker">
                            <button type="button" class="btn btn-sm btn-warning text-white rv-star-btn" data-star="1">1 ★</button>
                            <button type="button" class="btn btn-sm btn-warning text-white rv-star-btn" data-star="2">2 ★</button>
                            <button type="button" class="btn btn-sm btn-warning text-white rv-star-btn" data-star="3">3 ★</button>
                            <button type="button" class="btn btn-sm btn-warning text-white rv-star-btn" data-star="4">4 ★</button>
                            <button type="button" class="btn btn-sm btn-warning text-white rv-star-btn" data-star="5">5 ★</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Bình luận chi tiết *</label>
                        <textarea id="rvCommentInput" class="form-control rounded-3" rows="2" placeholder="Chia sẻ chất lượng thực tế, độ uy tín người bán, giá cả..." required></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold">
                            <i class="bi bi-send-fill me-1"></i> Gửi Đánh Giá
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL XEM VIDEO SẢN PHẨM ================= -->
<div class="modal fade" id="modalVideoPreview" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 bg-dark text-white overflow-hidden">
            <div class="modal-header border-secondary px-4 py-2">
                <h6 class="modal-title fw-bold mb-0" id="vpTitle">Video kiểm tra thực tế sản phẩm</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 bg-black text-center">
                <video id="vpPlayer" class="w-100" style="max-height: 440px;" controls autoplay playsinline></video>
            </div>
        </div>
    </div>
</div>

<script>
    var ecoItemsStore = [];
    var currentFilterType = 'all';
    var draftEcoImageData = '';
    var draftEcoVideoData = '';
    var selectedReviewStars = 5;

    function escEco(s) {
        return String(s || '').replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function fmtVnd(val) {
        var n = Number(val || 0);
        if (!n) return '0 VNĐ (Miễn Phí)';
        return n.toLocaleString('vi-VN') + ' đ';
    }

    function renderStarBadges(avg) {
        var rounded = Math.round(avg || 5);
        var html = '';
        for (var i = 1; i <= 5; i++) {
            html += i <= rounded ? '<i class="bi bi-star-fill text-warning"></i>' : '<i class="bi bi-star text-warning"></i>';
        }
        return html;
    }

    function renderEcoGrid(items) {
        ecoItemsStore = Array.isArray(items) ? items : [];
        var grid = document.getElementById('ecoGrid');
        if (!grid) return;

        var filtered = ecoItemsStore.filter(function (x) {
            return currentFilterType === 'all' || (x.danhMuc || 'electronics') === currentFilterType;
        });

        var countEl = document.getElementById('ecoTotalCount');
        if (countEl) countEl.innerText = String(filtered.length);

        if (!filtered.length) {
            grid.innerHTML = '<div class="col-12 text-center py-5 text-muted">Chưa có món đồ nào trong danh mục này.</div>';
            return;
        }

        grid.innerHTML = filtered.map(function (item) {
            var isFree = (item.danhMuc === 'free') || Number(item.giaBan || 0) <= 0;
            var imgSrc = item.hinhAnhUrl || 'https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?auto=format&fit=crop&w=600&q=80';
            var hasVideo = !!(item.videoUrl && String(item.videoUrl).trim());
            var reviews = Array.isArray(item.danhGias) ? item.danhGias : [];
            var avgStars = Number(item.soSaoTrungBinh || 5).toFixed(1);
            var revCount = Number(item.soLuotDanhGia || reviews.length || 0);
            var latestComment = reviews.length ? reviews[0] : null;
            var maTin = escEco(item.maTin);

            return '<div class="col-xl-4 col-md-6 eco-item" data-type="' + escEco(item.danhMuc) + '">' +
                '<div class="card-custom h-100 p-0 overflow-hidden shadow-sm border d-flex flex-column"' + (isFree ? ' style="border: 2px dashed #10B981 !important;"' : '') + '>' +
                    '<div class="position-relative">' +
                        '<img src="' + escEco(imgSrc) + '" alt="' + escEco(item.tieuDe) + '" class="w-100" style="height: 180px; object-fit: cover;">' +
                        '<span class="badge bg-primary position-absolute top-0 start-0 m-2">Phòng ' + escEco(item.kyHieuPhong || 'P.305') + '</span>' +
                        '<span class="badge bg-success-subtle text-success position-absolute top-0 end-0 m-2">' + escEco(item.tinhTrang || 'Mới đăng') + '</span>' +
                        (hasVideo ? '<button type="button" class="btn btn-sm btn-dark bg-opacity-75 position-absolute bottom-0 end-0 m-2 rounded-pill px-2 py-1" onclick="openEcoVideoModal(\'' + maTin + '\')"><i class="bi bi-play-circle-fill text-danger me-1"></i>Xem Video</button>' : '') +
                    '</div>' +
                    '<div class="p-3 d-flex flex-column flex-grow-1">' +
                        '<h6 class="fw-bold mb-1 text-slate-900">' + escEco(item.tieuDe) + '</h6>' +
                        '<div class="d-flex align-items-center gap-2 mb-2 small">' +
                            '<span class="d-inline-flex gap-1">' + renderStarBadges(Number(avgStars)) + '</span>' +
                            '<strong class="text-dark">' + avgStars + '</strong>' +
                            '<span class="text-muted">(' + revCount + ' đánh giá)</span>' +
                        '</div>' +
                        '<p class="text-muted fs-8 mb-2">' + escEco(item.moTa) + '</p>' +
                        (latestComment ? '<div class="bg-light rounded-3 p-2 mb-2 border small"><strong class="text-primary">' + escEco(latestComment.nguoiDanhGia) + ':</strong> ' + escEco(latestComment.binhLuan) + '</div>' : '') +
                        '<div class="mt-auto pt-2 border-top">' +
                            '<div class="d-flex justify-content-between align-items-center mb-2">' +
                                '<div>' +
                                    '<div class="text-muted fs-9">' + (isFree ? 'Giá trao đổi:' : 'Giá pass lại:') + '</div>' +
                                    '<div class="fw-bold ' + (isFree ? 'text-success' : 'text-danger') + ' fs-6">' + fmtVnd(item.giaBan) +
                                        (!isFree && Number(item.giaGoc || 0) > Number(item.giaBan || 0) ? ' <span class="text-muted text-decoration-line-through fs-9">' + fmtVnd(item.giaGoc) + '</span>' : '') +
                                    '</div>' +
                                '</div>' +
                                '<button type="button" class="btn btn-sm ' + (isFree ? 'btn-outline-success' : 'btn-success') + ' rounded-3 shadow-sm" onclick="' + (isFree ? 'claimFreeItem' : 'buyItem') + '(\'' + escEco(item.tieuDe) + '\', \'' + fmtVnd(item.giaBan) + '\', \'' + escEco(item.nguoiBan || 'Hồ Ngọc Bảo (P.305)') + '\')">' +
                                    '<i class="bi ' + (isFree ? 'bi-gift-fill' : 'bi-cart-plus') + ' me-1"></i> ' + (isFree ? 'Xin Nhận' : 'Nhắn Mua') +
                                '</button>' +
                            '</div>' +
                            '<div class="d-flex flex-wrap gap-2">' +
                                '<button type="button" class="btn btn-sm btn-outline-warning text-dark flex-grow-1 rounded-3" onclick="openReviewModal(\'' + maTin + '\')">' +
                                    '<i class="bi bi-star-fill text-warning me-1"></i> Đánh giá &amp; Bình luận</button>' +
                                '<button type="button" class="btn btn-sm btn-outline-primary rounded-3" onclick="callSeller(\'' + maTin + '\')">' +
                                    '<i class="bi bi-camera-video-fill me-1"></i> Gọi</button>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }).join('');
    }

    async function loadEcoItems() {
        try {
            var res = await fetch('/api/sync/snapshot');
            if (res.ok) {
                var snap = await res.json();
                if (Array.isArray(snap.choDoCu) && snap.choDoCu.length) {
                    renderEcoGrid(snap.choDoCu);
                    return;
                }
            }
        } catch (_) { }
        renderEcoGrid([
            {
                maTin: 'MKT-001',
                tieuDe: 'Quạt đứng Senko 3 tốc độ gió có hẹn giờ',
                danhMuc: 'electronics',
                giaBan: 120000,
                giaGoc: 350000,
                kyHieuPhong: 'P.305',
                nguoiBan: 'Hồ Ngọc Bảo (P.305)',
                tinhTrang: 'Mới 95%',
                moTa: 'Dùng được 4 tháng, chạy êm ru, có remote điều khiển.',
                hinhAnhUrl: 'https://images.unsplash.com/photo-1585338107529-13afc5f02586?auto=format&fit=crop&w=600&q=80',
                videoUrl: 'https://www.w3schools.com/html/mov_bbb.mp4',
                soSaoTrungBinh: 5.0,
                soLuotDanhGia: 1,
                danhGias: [{ nguoiDanhGia: 'Minh Anh', kyHieuPhong: 'P.201', soSao: 5, binhLuan: 'Quạt chạy êm, chủ phòng nhiệt tình!', thoiGian: 'Hôm qua' }]
            }
        ]);
    }

    function buyItem(name, price, seller) {
        showEcoAlert('Đã kết nối chat trực tiếp với người bán ' + seller + ' để mua "' + name + '" (' + price + ')!');
    }

    function claimFreeItem(name, price, giver) {
        showEcoAlert('Đã gửi yêu cầu xin nhận "' + name + '" tới bạn ' + giver + '!');
    }

    function callSeller(maTin) {
        var found = ecoItemsStore.find(function (x) { return x.maTin === maTin; });
        var seller = found ? (found.nguoiBan + ' (' + (found.kyHieuPhong || 'P.305') + ')') : 'Cư dân SmartStay';
        if (window.openSmartStayCallModal) {
            window.openSmartStayCallModal('CuDan', seller, true);
        } else {
            showEcoAlert('Đang gọi trực tiếp cho người bán ' + seller);
        }
    }

    function resolvePlayableEcoVideo(url) {
        var raw = String(url || '').trim();
        if (!raw) return '';
        if (raw.indexOf('demo://') === 0 || raw.indexOf('interactive-examples.mdn.mozilla.net/media/cc0-videos/flower') !== -1) {
            return 'https://www.w3schools.com/html/mov_bbb.mp4';
        }
        return raw;
    }

    function openEcoVideoModal(maTin) {
        var found = ecoItemsStore.find(function (x) { return x.maTin === maTin; });
        if (!found || !found.videoUrl) return;
        document.getElementById('vpTitle').innerText = 'Video thực tế: ' + found.tieuDe;
        var player = document.getElementById('vpPlayer');
        player.muted = false;
        player.volume = 1.0;
        player.src = resolvePlayableEcoVideo(found.videoUrl);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalVideoPreview')).show();
        setTimeout(function () {
            try {
                player.muted = false;
                player.volume = 1.0;
                player.play().catch(function () { });
            } catch (_) { }
        }, 120);
    }

    var vpModalEl = document.getElementById('modalVideoPreview');
    if (vpModalEl) {
        vpModalEl.addEventListener('hidden.bs.modal', function () {
            var p = document.getElementById('vpPlayer');
            if (p) { p.pause(); p.removeAttribute('src'); }
        });
    }

    function filterEco(type, btn) {
        currentFilterType = type || 'all';
        document.querySelectorAll('.eco-filter-btn').forEach(function (b) { b.classList.remove('active'); });
        if (btn) btn.classList.add('active');
        renderEcoGrid(ecoItemsStore);
    }

    function onEcoImageSelected(input) {
        var file = input && input.files && input.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function (ev) {
            var img = new Image();
            img.onload = function () {
                var maxW = 720;
                var scale = img.width > maxW ? (maxW / img.width) : 1;
                var canvas = document.createElement('canvas');
                canvas.width = Math.round(img.width * scale);
                canvas.height = Math.round(img.height * scale);
                canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
                draftEcoImageData = canvas.toDataURL('image/jpeg', 0.72);
                var prev = document.getElementById('piImagePreview');
                prev.src = draftEcoImageData;
                prev.classList.remove('d-none');
                document.getElementById('piImageHint').innerText = 'Đã đính kèm ảnh chụp thực tế (' + file.name + ').';
            };
            img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
    }

    function clearEcoImage() {
        draftEcoImageData = '';
        var inp = document.getElementById('piImageInput');
        if (inp) inp.value = '';
        var prev = document.getElementById('piImagePreview');
        if (prev) { prev.src = ''; prev.classList.add('d-none'); }
        document.getElementById('piImageHint').innerText = 'Chưa chọn ảnh mới (sẽ dùng ảnh mặc định nếu bỏ trống).';
    }

    async function uploadEcoVideoDataUrl(dataUrl, fileName, contentType) {
        try {
            var res = await fetch('/api/sync/upload-media', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    FileName: fileName || 'eco-video.mp4',
                    ContentType: contentType || 'video/mp4',
                    Base64Data: dataUrl,
                    Folder: 'marketplace-videos'
                })
            });
            if (res.ok) {
                var json = await res.json();
                if (json && json.publicUrl) return json.publicUrl;
            }
        } catch (_) { }
        return dataUrl;
    }

    function onEcoVideoSelected(input) {
        var file = input && input.files && input.files[0];
        if (!file) return;
        var status = document.getElementById('piVideoStatus');
        status.innerText = 'Đang tải video "' + file.name + '" lên Supabase Storage...';
        var reader = new FileReader();
        reader.onload = async function (ev) {
            var rawDataUrl = ev.target.result;
            var v = document.getElementById('piVideoPreview');
            v.muted = false;
            v.src = rawDataUrl;
            v.classList.remove('d-none');
            var uploadedUrl = await uploadEcoVideoDataUrl(rawDataUrl, file.name, file.type || 'video/mp4');
            draftEcoVideoData = uploadedUrl;
            status.innerText = 'Đã tải video "' + file.name + '" kèm âm thanh lên Cloud thành công!';
        };
        reader.readAsDataURL(file);
    }

    async function recordEcoVideo5s() {
        var btn = document.getElementById('piRecordVideoBtn');
        var status = document.getElementById('piVideoStatus');
        var preview = document.getElementById('piVideoPreview');
        btn.disabled = true;
        status.innerText = 'Đang khởi động camera & micro quay video 4 giây...';

        try {
            var stream = null;
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia && window.MediaRecorder) {
                try {
                    stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                } catch (_) {
                    try {
                        stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
                    } catch (_e2) {
                        stream = null;
                    }
                }
            }
            if (!stream && window.MediaRecorder) {
                var c = document.createElement('canvas');
                c.width = 360;
                c.height = 200;
                var ctx = c.getContext('2d');
                var tick = 0;
                var drawTimer = setInterval(function () {
                    tick += 1;
                    ctx.fillStyle = '#0F172A';
                    ctx.fillRect(0, 0, c.width, c.height);
                    ctx.fillStyle = '#38BDF8';
                    ctx.font = 'bold 16px sans-serif';
                    ctx.fillText('SMARTSTAY ECO VIDEO LIVE', 52, 85);
                    ctx.fillStyle = '#E2E8F0';
                    ctx.font = '13px sans-serif';
                    ctx.fillText('Quay kiểm tra sản phẩm (' + tick + ')', 80, 120);
                }, 200);
                stream = c.captureStream ? c.captureStream(10) : null;
                setTimeout(function () { clearInterval(drawTimer); }, 2500);
            }
            if (stream && window.MediaRecorder) {
                var chunks = [];
                var rec = new MediaRecorder(stream);
                rec.ondataavailable = function (e) { if (e.data && e.data.size > 0) chunks.push(e.data); };
                rec.onstop = function () {
                    stream.getTracks().forEach(function (t) { t.stop(); });
                    var blob = new Blob(chunks, { type: 'video/webm' });
                    var fr = new FileReader();
                    fr.onload = async function (ev) {
                        var rawDataUrl = ev.target.result;
                        preview.muted = false;
                        preview.src = rawDataUrl;
                        preview.classList.remove('d-none');
                        status.innerText = 'Đang đồng bộ video vừa quay lên Cloud...';
                        draftEcoVideoData = await uploadEcoVideoDataUrl(rawDataUrl, 'recorded-eco-clip.webm', 'video/webm');
                        status.innerText = 'Đã quay & lưu video thực tế có âm thanh! Sẵn sàng đăng bán.';
                        btn.disabled = false;
                    };
                    fr.readAsDataURL(blob);
                };
                rec.start();
                setTimeout(function () { if (rec.state !== 'inactive') rec.stop(); }, 3200);
                return;
            }
        } catch (_) { }

        draftEcoVideoData = 'https://www.w3schools.com/html/mov_bbb.mp4';
        preview.muted = false;
        preview.src = draftEcoVideoData;
        preview.classList.remove('d-none');
        status.innerText = 'Đã gắn video kiểm tra sản phẩm có âm thanh.';
        btn.disabled = false;
    }

    async function handlePostItem(e) {
        e.preventDefault();
        var title = document.getElementById('piTitle').value.trim();
        var priceRaw = document.getElementById('piPrice').value.replace(/[^\d]/g, '');
        var priceNum = Number(priceRaw || 0);
        var desc = document.getElementById('piDesc').value.trim();
        var category = document.getElementById('piCategory').value;
        var submitBtn = document.getElementById('piSubmitBtn');
        submitBtn.disabled = true;

        try {
            var res = await fetch('/api/sync/cho-do-cu', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    TieuDe: title,
                    DanhMuc: category,
                    GiaBan: category === 'free' ? 0 : priceNum,
                    GiaGoc: category === 'free' ? 0 : Math.round(priceNum * 1.8),
                    KyHieuPhong: 'P.305',
                    NguoiBan: 'Hồ Ngọc Bảo (P.305)',
                    TinhTrang: 'Mới đăng',
                    MoTa: desc,
                    HinhAnhUrl: draftEcoImageData || 'https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?auto=format&fit=crop&w=600&q=80',
                    VideoUrl: draftEcoVideoData || null
                })
            });
            if (res.ok) {
                var data = await res.json();
                if (Array.isArray(data.choDoCu)) {
                    renderEcoGrid(data.choDoCu);
                } else {
                    await loadEcoItems();
                }
            }
        } catch (_) { }

        submitBtn.disabled = false;
        document.getElementById('postItemForm').reset();
        clearEcoImage();
        draftEcoVideoData = '';
        var pv = document.getElementById('piVideoPreview');
        if (pv) { pv.removeAttribute('src'); pv.classList.add('d-none'); }
        document.getElementById('piVideoStatus').innerText = 'Quay nhanh video kiểm tra hoạt động hoặc tải video có sẵn.';

        var modal = bootstrap.Modal.getInstance(document.getElementById('modalPostItem'));
        if (modal) modal.hide();
        filterEco('all', document.getElementById('ecoFilterAll'));
        showEcoAlert('Đã đăng món đồ "' + title + '" kèm media lên sàn trao đổi thành công!');
    }

    function setStarPicker(star) {
        selectedReviewStars = star;
        document.querySelectorAll('#rvStarPicker .rv-star-btn').forEach(function (b) {
            var v = Number(b.getAttribute('data-star') || 0);
            b.className = 'btn btn-sm rv-star-btn ' + (v <= selectedReviewStars ? 'btn-warning text-white' : 'btn-outline-secondary');
        });
    }

    document.querySelectorAll('#rvStarPicker .rv-star-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            setStarPicker(Number(btn.getAttribute('data-star') || 5));
        });
    });

    function openReviewModal(maTin) {
        var found = ecoItemsStore.find(function (x) { return x.maTin === maTin; });
        if (!found) return;
        document.getElementById('rvMaTin').value = found.maTin;
        document.getElementById('rvTieuDeFallback').value = found.tieuDe;
        document.getElementById('rvItemSubtitle').innerText = found.tieuDe + ' • ' + (found.nguoiBan || 'P.305');
        setStarPicker(5);

        var reviews = Array.isArray(found.danhGias) ? found.danhGias : [];
        var listEl = document.getElementById('rvExistingList');
        if (!reviews.length) {
            listEl.innerHTML = '<div class="text-muted small">Chưa có bình luận nào. Hãy là người đầu tiên đánh giá sản phẩm này!</div>';
        } else {
            listEl.innerHTML = reviews.map(function (r) {
                return '<div class="p-2 rounded-3 border bg-light">' +
                    '<div class="d-flex justify-content-between align-items-center mb-1">' +
                        '<strong class="small text-primary">' + escEco(r.nguoiDanhGia) + ' (' + escEco(r.kyHieuPhong || 'P.305') + ')</strong>' +
                        '<span class="small">' + renderStarBadges(r.soSao || 5) + ' <span class="text-muted">(' + escEco(r.thoiGian || 'Vừa xong') + ')</span></span>' +
                    '</div>' +
                    '<div class="small text-dark">' + escEco(r.binhLuan) + '</div>' +
                '</div>';
            }).join('');
        }

        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalItemReview')).show();
    }

    async function submitEcoReview(e) {
        e.preventDefault();
        var maTin = document.getElementById('rvMaTin').value;
        var tieuDe = document.getElementById('rvTieuDeFallback').value;
        var comment = document.getElementById('rvCommentInput').value.trim();
        if (!comment) return;

        try {
            var res = await fetch('/api/sync/cho-do-cu/danh-gia', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    MaTin: maTin,
                    TieuDeFallback: tieuDe,
                    NguoiDanhGia: 'Hồ Ngọc Bảo',
                    KyHieuPhong: 'P.305',
                    SoSao: selectedReviewStars,
                    BinhLuan: comment
                })
            });
            if (res.ok) {
                var data = await res.json();
                if (data.item) {
                    var idx = ecoItemsStore.findIndex(function (x) { return x.maTin === maTin; });
                    if (idx >= 0) ecoItemsStore[idx] = data.item;
                    renderEcoGrid(ecoItemsStore);
                    openReviewModal(maTin);
                }
            }
        } catch (_) { }
        document.getElementById('rvCommentInput').value = '';
        showEcoAlert('Cảm ơn bạn đã gửi đánh giá ' + selectedReviewStars + ' sao & bình luận chi tiết!');
    }

    function showEcoAlert(msg) {
        var box = document.getElementById('ecoAlert');
        document.getElementById('ecoAlertText').innerText = msg;
        box.classList.remove('d-none');
        box.classList.add('show');
        setTimeout(function () {
            box.classList.remove('show');
            box.classList.add('d-none');
        }, 5000);
    }

    document.addEventListener('DOMContentLoaded', loadEcoItems);
</script>
