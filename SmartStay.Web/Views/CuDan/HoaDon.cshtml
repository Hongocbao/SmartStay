@{
    ViewData["Title"] = "Hóa Đơn Sinh Hoạt & Thanh Toán VietQR";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Cột trái: Mã VietQR & Hành động -->
    <div class="col-lg-5">
        <div class="card-custom text-center p-4">
            <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill fw-bold mb-3">
                <i class="bi bi-clock-history me-1"></i> TRẠNG THÁI: CHỜ ĐỐI SOÁT
            </span>
            <h5 class="fw-bold mb-1">Quét Mã VietQR NAPAS 24/7</h5>
            <p class="fs-8 text-muted mb-3">Tự động điền đúng Số Tiền và Nội dung chuyển khoản</p>

            <div class="p-3 bg-light rounded-4 border d-inline-block mb-3 shadow-sm">
                <img src="https://img.vietqr.io/image/970422-0987654321-compact2.png?amount=4159000&addInfo=HD1026%20P305%20HONGOCBAO&accountName=SMARTSTAY%20MANAGEMENT" 
                     alt="VietQR Hóa đơn P.305" 
                     class="img-fluid rounded-3" 
                     style="max-width: 250px;">
            </div>

            <div class="text-start bg-light p-3 rounded-3 border mb-3 fs-8">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Ngân hàng:</span>
                    <strong class="text-primary">MBBank (Quân Đội)</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Số tài khoản:</span>
                    <strong class="text-dark">0987654321</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Chủ tài khoản:</span>
                    <strong>SMARTSTAY MANAGEMENT</strong>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Số tiền cần trả:</span>
                    <strong class="text-danger fs-6">4.159.000 đ</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Nội dung:</span>
                    <code class="text-primary fw-bold">HD1026 P305 HONGOCBAO</code>
                </div>
            </div>

            <button class="btn btn-primary rounded-pill w-100 py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#uploadReceiptModal">
                <i class="bi bi-upload me-1"></i> Nộp Biên Lai Sau Khi Chuyển Khoản
            </button>
        </div>
    </div>

    <!-- Cột phải: Chi tiết Bậc thang Điện Nước & Tiền phòng -->
    <div class="col-lg-7">
        <div class="card-custom mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h6 class="fw-bold mb-0 text-slate-900"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Hóa Đơn Kỳ Tháng 10/2026</h6>
                    <span class="fs-9 text-muted">Mã số: <strong>HD-2026-10-305</strong> • Phòng: <strong class="text-primary">P.305</strong></span>
                </div>
                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fs-7 fw-bold">
                    Tổng tiền: 4.159.000 đ
                </span>
            </div>

            <!-- Bảng chi tiết tính tiền -->
            <div class="table-responsive">
                <table class="table table-bordered align-middle fs-8 mb-3">
                    <thead class="table-light">
                        <tr>
                            <th>KHOẢN MỤC THU</th>
                            <th class="text-center">SẢN LƯỢNG</th>
                            <th class="text-end">ĐƠN GIÁ</th>
                            <th class="text-end">THÀNH TIỀN</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold">Tiền thuê phòng P.305 (Studio)</td>
                            <td class="text-center">1 Tháng</td>
                            <td class="text-end">3.500.000 đ</td>
                            <td class="text-end fw-bold">3.500.000 đ</td>
                        </tr>
                        <!-- Điện bậc thang -->
                        <tr class="table-primary-subtle">
                            <td colspan="4" class="fw-bold text-primary">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Tiền điện sinh hoạt lũy tiến (Chỉ số: 1.150 - 1.270 = 120 kWh)
                            </td>
                        </tr>
                        <tr>
                            <td class="ps-4 text-muted">• Bậc 1 (0 - 50 kWh)</td>
                            <td class="text-center">50 kWh</td>
                            <td class="text-end">1.800 đ</td>
                            <td class="text-end">90.000 đ</td>
                        </tr>
                        <tr>
                            <td class="ps-4 text-muted">• Bậc 2 (51 - 100 kWh)</td>
                            <td class="text-center">50 kWh</td>
                            <td class="text-end">2.200 đ</td>
                            <td class="text-end">110.000 đ</td>
                        </tr>
                        <tr>
                            <td class="ps-4 text-muted">• Bậc 3 (101 - 200 kWh)</td>
                            <td class="text-center">20 kWh</td>
                            <td class="text-end">2.700 đ</td>
                            <td class="text-end">54.000 đ</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-bold text-primary">Cộng tiền điện:</td>
                            <td class="text-end fw-bold text-primary">254.000 đ</td>
                        </tr>

                        <!-- Nước bậc thang -->
                        <tr class="table-info-subtle">
                            <td colspan="4" class="fw-bold text-info">
                                <i class="bi bi-droplet-fill me-1"></i> Tiền nước sinh hoạt lũy tiến (Chỉ số: 104 - 112 = 8 m³)
                            </td>
                        </tr>
                        <tr>
                            <td class="ps-4 text-muted">• Bậc 1 (0 - 5 m³)</td>
                            <td class="text-center">5 m³</td>
                            <td class="text-end">12.000 đ</td>
                            <td class="text-end">60.000 đ</td>
                        </tr>
                        <tr>
                            <td class="ps-4 text-muted">• Bậc 2 (6 - 10 m³)</td>
                            <td class="text-center">3 m³</td>
                            <td class="text-end">15.000 đ</td>
                            <td class="text-end">45.000 đ</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-bold text-info">Cộng tiền nước:</td>
                            <td class="text-end fw-bold text-info">105.000 đ</td>
                        </tr>

                        <!-- Dịch vụ cố định -->
                        <tr>
                            <td class="fw-bold">Phí dịch vụ Co-Living (Wifi tốc độ cao, Rác, Bảo trì BQL)</td>
                            <td class="text-center">1 Gói</td>
                            <td class="text-end">300.000 đ</td>
                            <td class="text-end fw-bold">300.000 đ</td>
                        </tr>
                        <tr class="table-danger-subtle fs-7">
                            <td colspan="3" class="text-end fw-bold text-danger">TỔNG CỘNG THANH TOÁN:</td>
                            <td class="text-end fw-bold text-danger fs-6">4.159.000 đ</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Cảnh báo bất thường AI -->
            <div class="p-3 bg-light rounded-3 border border-success-subtle">
                <div class="d-flex align-items-center gap-2 text-success fw-bold fs-8 mb-1">
                    <i class="bi bi-check-circle-fill"></i> Phân Tích Mức Độ Tiêu Thụ Hợp Lý:
                </div>
                <p class="fs-8 text-muted mb-0">
                    Sản lượng tiêu thụ tháng này (120 kWh điện, 8 m³ nước) tương đương với tháng 09/2026 (+4%), không có dấu hiệu bất thường hay rò rỉ đường ống.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nộp Biên Lai -->
<div class="modal fade" id="uploadReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form action="/CuDan/NopBienLai" method="post">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold"><i class="bi bi-upload text-primary me-2"></i>Nộp Biên Lai Thanh Toán</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="maHoaDon" value="HD-2026-10-305" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Hóa đơn thanh toán:</label>
                        <input type="text" class="form-control form-control-sm bg-light" value="HD-2026-10-305 (Phòng P.305 - 4.159.000 đ)" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Mã giao dịch ngân hàng / FT code: *</label>
                        <input type="text" class="form-control" name="maGiaoDich" placeholder="Ví dụ: FT263058899201" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Ghi chú xác nhận:</label>
                        <textarea class="form-control" name="ghiChu" rows="2" placeholder="Cư dân Hồ Ngọc Bảo đã chuyển khoản VietQR"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Xác nhận nộp biên lai</button>
                </div>
            </form>
        </div>
    </div>
</div>
