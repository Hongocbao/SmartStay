    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/smartstay-rtc.js" asp-append-version="true"></script>
    <script>
        (function () {
            var root = document.getElementById('ssAiBubbleRoot');
            if (!root) return;

            var launcherBtn = document.getElementById('ssAiLauncherBtn');
            var popup = document.getElementById('ssAiChatPopup');
            var closeBtn = document.getElementById('ssAiCloseBtn');
            var clearBtn = document.getElementById('ssAiClearBtn');
            var callBtnHeader = document.getElementById('ssAiCallBtn');
            var messagesEl = document.getElementById('ssAiMessages');
            var chipsBar = document.getElementById('ssAiChipsBar');
            var inputEl = document.getElementById('ssAiInput');
            var sendBtn = document.getElementById('ssAiSendBtn');
            var headerTitle = document.getElementById('ssAiHeaderTitle');
            var headerSub = document.getElementById('ssAiHeaderSub');

            var serverRole = (root.getAttribute('data-role') || 'CuDan');
            var fullName = root.getAttribute('data-fullname') || 'Người dùng SmartStay';
            var roomCode = root.getAttribute('data-room') || 'P.305';
            var activeMode = serverRole === 'Admin' ? 'admin' : ((serverRole === 'QuanLy' || serverRole === 'KyThuat') ? 'manager' : 'resident');

            var adminChips = [
                'Báo cáo doanh thu & công nợ tháng này',
                'Kiểm tra cấu hình ngân hàng VietQR & hệ thống',
                'Thống kê phòng trống & tỷ lệ lấp đầy',
                'Phát thông báo nhắc đóng phí toàn tòa nhà',
                'Tổng hợp nhật ký cuộc gọi & bảo trì Kanban'
            ];

            var managerChips = [
                'Kiểm tra sự cố Kanban khẩn cấp',
                'Điều phối kỹ thuật viên xử lý phòng P.305',
                'Cảnh báo khóa IoT & chỉ số điện nước bất thường',
                'Phát thông báo kiểm tra PCCC định kỳ',
                'Báo cáo tỷ lệ phòng sắp hết hạn hợp đồng'
            ];

            var residentChips = [
                'Tại sao tháng này tiền điện phòng tôi cao vậy?',
                'Bảng giá điện nước bậc thang hiện tại',
                'Phòng tôi bị rỉ nước vòi sen, gọi thợ sửa gấp!',
                'Hướng dẫn thanh toán hóa đơn VietQR',
                'Cách đăng bán đồ cũ kèm video & đánh giá 5 sao'
            ];

            function renderHeaderAndChips() {
                var chips = residentChips;
                if (activeMode === 'admin') {
                    headerTitle.innerText = 'AI Copilot Admin Hệ Thống';
                    headerSub.innerText = fullName + ' • Quyền Admin Hệ thống';
                    chips = adminChips;
                } else if (activeMode === 'manager') {
                    headerTitle.innerText = 'AI Điều Hành Ban Quản Lý';
                    headerSub.innerText = fullName + ' • Ban Quản lý & Kỹ thuật';
                    chips = managerChips;
                } else {
                    headerTitle.innerText = 'SmartStay AI Cư Dân';
                    headerSub.innerText = fullName + ' (' + roomCode + ') • Hỗ trợ Cư dân';
                    chips = residentChips;
                }

                chipsBar.innerHTML = '';
                chips.forEach(function (label) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'ss-ai-chip';
                    b.innerText = label;
                    b.addEventListener('click', function () {
                        sendMessage(label);
                    });
                    chipsBar.appendChild(b);
                });
            }

            function appendBubble(sender, text) {
                var row = document.createElement('div');
                row.className = 'ss-ai-msg-row ' + (sender === 'user' ? 'user' : 'bot');
                var bubble = document.createElement('div');
                bubble.className = 'ss-ai-msg-bubble';
                bubble.innerText = text;
                row.appendChild(bubble);
                messagesEl.appendChild(row);
                messagesEl.scrollTop = messagesEl.scrollHeight;
                return bubble;
            }

            function resetMessages() {
                messagesEl.innerHTML = '';
                if (activeMode === 'admin') {
                    appendBubble(
                        'bot',
                        'Xin chào ' + fullName + '! Tôi là AI Copilot cho Admin.\nTôi có thể tổng hợp doanh thu & công nợ toàn hệ thống, rà soát cấu hình VietQR/tài khoản, kiểm tra tỷ lệ lấp đầy hoặc phát thông báo toàn tòa nhà.'
                    );
                } else if (activeMode === 'manager') {
                    appendBubble(
                        'bot',
                        'Xin chào Ban Quản Lý (' + fullName + ')! Tôi hỗ trợ điều phối vận hành trực tiếp.\nTôi có thể kiểm tra ticket Kanban khẩn cấp, cảnh báo khóa IoT, giám sát công tơ điện nước hoặc mở cuộc gọi trao đổi nhanh với cư dân/kỹ thuật.'
                    );
                } else {
                    appendBubble(
                        'bot',
                        'Xin chào ' + fullName + ' (' + roomCode + ')! Tôi là SmartStay AI Concierge cho Người dùng.\nTôi có thể giải thích hóa đơn điện nước bậc thang, tạo ngay phiếu sự cố Kanban có ảnh/video, hoặc hỗ trợ đăng bán & đánh giá tại Chợ Đồ Cũ.'
                    );
                }
            }

            async function executeAgenticSideEffects(query) {
                var q = query.toLowerCase();
                var extras = [];

                if ((activeMode === 'admin' || activeMode === 'manager') && (q.includes('phát thông báo') || q.includes('gửi thông báo')) && (q.includes('nhắc') || q.includes('phí') || q.includes('tiền') || q.includes('pccc'))) {
                    try {
                        var resNotice = await fetch('/api/sync/thong-bao', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                TieuDe: q.includes('pccc') ? 'Kiểm tra hệ thống PCCC & an toàn căn hộ' : 'Nhắc lịch thanh toán hóa đơn dịch vụ tháng 10',
                                NoiDung: 'Ban Quản Lý kính đề nghị Quý cư dân kiểm tra chỉ số điện nước và hoàn tất thanh toán qua mã VietQR trong ứng dụng trước ngày 05.',
                                PhamViNhan: 'Toàn tòa nhà',
                                LaKhanCap: true
                            })
                        });
                        if (resNotice.ok) {
                            extras.push('✅ Đã tự động đăng thông báo lên Bảng tin cư dân & Realtime Sync!');
                        }
                    } catch (_) { }
                } else if ((activeMode === 'admin' || activeMode === 'manager') && (q.includes('doanh thu') || q.includes('phòng trống') || q.includes('sự cố') || q.includes('kanban') || q.includes('cuộc gọi') || q.includes('tổng hợp'))) {
                    try {
                        var snapRes = await fetch('/api/sync/snapshot');
                        if (snapRes.ok) {
                            var snap = await snapRes.json();
                            var roomCount = Array.isArray(snap.phongs) ? snap.phongs.length : 0;
                            var ticketCount = Array.isArray(snap.suCos) ? snap.suCos.length : 0;
                            var callCount = Array.isArray(snap.cuocGois) ? snap.cuocGois.length : 0;
                            if (roomCount > 0 || ticketCount > 0 || callCount > 0) {
                                extras.push('🔄 Dữ liệu Realtime Snapshot: ' + roomCount + ' phòng đồng bộ • ' + ticketCount + ' phiếu sự cố • ' + callCount + ' cuộc gọi.');
                            }
                        }
                    } catch (_) { }
                } else if (activeMode === 'resident' && (q.includes('rỉ nước') || q.includes('vòi sen') || q.includes('hỏng') || q.includes('sửa') || q.includes('máy lạnh'))) {
                    try {
                        var ticketCode = 'SC-2026-' + Math.floor(100 + Math.random() * 899);
                        var resTicket = await fetch('/api/sync/su-co', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                SoPhieuSuCo: ticketCode,
                                KyHieuPhong: roomCode,
                                TieuDe: query.slice(0, 80),
                                MoTa: 'Khởi tạo từ Bong bóng Chat AI: ' + query,
                                UuTien: 'Khẩn cấp',
                                TrangThai: 'Chờ xử lý'
                            })
                        });
                        if (resTicket.ok) {
                            extras.push('🎫 Đã tạo phiếu Kanban ' + ticketCode + ' cho phòng ' + roomCode + ' và gửi sang điều phối kỹ thuật.');
                        }
                    } catch (_) { }
                }
                return extras;
            }

            async function sendMessage(overrideText) {
                var text = (typeof overrideText === 'string' ? overrideText : inputEl.value).trim();
                if (!text) return;

                appendBubble('user', text);
                if (typeof overrideText !== 'string') {
                    inputEl.value = '';
                }

                var typingBubble = appendBubble('bot', '⏳ AI đang phân tích ngữ cảnh & truy xuất dữ liệu...');
                var mappedRole = activeMode === 'admin' ? 'Admin' : (activeMode === 'manager' ? 'QuanLy' : 'CuDan');
                try {
                    var sideNotesPromise = executeAgenticSideEffects(text);
                    var apiRes = await fetch('/api/tro-ly/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            TinNhan: text,
                            VaiTro: mappedRole,
                            SoPhong: roomCode
                        })
                    });

                    var replyText = 'Trợ lý AI SmartStay sẵn sàng hỗ trợ bạn!';
                    if (apiRes.ok) {
                        var data = await apiRes.json();
                        if (data && data.traLoi) {
                            replyText = data.traLoi;
                        } else if (data && data.TraLoi) {
                            replyText = data.TraLoi;
                        }
                    }
                    var sideNotes = await sideNotesPromise;
                    if (sideNotes.length > 0) {
                        replyText = replyText + '\n\n' + sideNotes.join('\n');
                    }
                    typingBubble.innerText = replyText;
                } catch (err) {
                    typingBubble.innerText = 'Không kết nối được máy chủ AI lúc này, vui lòng thử lại sau.';
                }
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            launcherBtn.addEventListener('click', function () {
                popup.classList.toggle('d-none');
                if (!popup.classList.contains('d-none')) {
                    inputEl.focus();
                }
            });

            closeBtn.addEventListener('click', function () {
                popup.classList.add('d-none');
            });

            clearBtn.addEventListener('click', function () {
                resetMessages();
            });

            if (callBtnHeader) {
                callBtnHeader.addEventListener('click', function () {
                    popup.classList.add('d-none');
                    if (window.openSmartStayCallModal) {
                        var targetRole = activeMode === 'resident' ? 'QuanLy' : 'CuDan';
                        var targetName = activeMode === 'resident' ? 'Ban Quản Lý (Trực ca 24/7)' : 'Hồ Ngọc Bảo (Cư dân P.305)';
                        window.openSmartStayCallModal(targetRole, targetName, true);
                    }
                });
            }

            sendBtn.addEventListener('click', function () { sendMessage(); });
            inputEl.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });

            renderHeaderAndChips();
            resetMessages();

            // --- Logic Tổng Đài Thoại & Video Call 2 Thiết bị (SignalR + WebRTC Thực tế) ---
            var callModalEl = document.getElementById('ssCallCenterModal');
            var incomingModalEl = document.getElementById('ssIncomingCallModal');
            if (!callModalEl) return;

            var callState = {
                active: false,
                ringingOutgoing: false,
                connected: false,
                isVideo: true,
                micOn: true,
                camOn: true,
                seconds: 0,
                timerId: null,
                callId: '',
                targetClientId: '',
                targetRole: serverRole === 'CuDan' ? 'QuanLy' : 'CuDan',
                targetName: serverRole === 'CuDan' ? 'Ban Quản Lý (Trực ca 24/7)' : 'Hồ Ngọc Bảo (Cư dân P.305)',
                pendingIncomingPacket: null,
                hasSavedCurrentCall: false
            };

            var ringEl = document.getElementById('ssCallAvatarRing');
            var partnerLabel = document.getElementById('ssCallPartnerLabel');
            var statusBadge = document.getElementById('ssCallStatusBadge');
            var timerText = document.getElementById('ssCallTimerText');
            var remoteVideo = document.getElementById('ssCallRemoteVideo');
            var localVideo = document.getElementById('ssCallLocalVideo');
            var pipPlaceholder = document.getElementById('ssCallPipPlaceholder');
            var customTargetInput = document.getElementById('ssCallCustomTarget');
            var noteInput = document.getElementById('ssCallNoteInput');
            var startAudioBtn = document.getElementById('ssCallStartAudioBtn');
            var startVideoBtn = document.getElementById('ssCallStartVideoBtn');
            var micBtn = document.getElementById('ssCallMicBtn');
            var camBtn = document.getElementById('ssCallCamBtn');
            var endBtn = document.getElementById('ssCallEndBtn');
            var historyList = document.getElementById('ssCallHistoryList');
            var countBadge = document.getElementById('ssCallCountBadge');
            var onlinePeersBar = document.getElementById('ssCallOnlinePeersBar');

            var incomingNameEl = document.getElementById('ssIncomingCallerName');
            var incomingRoleEl = document.getElementById('ssIncomingCallerRole');
            var incomingModeBadge = document.getElementById('ssIncomingCallModeBadge');
            var incomingAcceptBtn = document.getElementById('ssIncomingAcceptBtn');
            var incomingRejectBtn = document.getElementById('ssIncomingRejectBtn');

            function fmtSec(s) {
                var m = String(Math.floor(s / 60)).padStart(2, '0');
                var rem = String(s % 60).padStart(2, '0');
                return m + ':' + rem;
            }

            function startCallTimer() {
                if (callState.timerId) clearInterval(callState.timerId);
                callState.seconds = 0;
                callState.timerId = setInterval(function () {
                    callState.seconds += 1;
                    statusBadge.innerText = (callState.isVideo ? 'Đang đàm thoại Video WebRTC' : 'Đang đàm thoại Thoại WebRTC') + ' • ' + fmtSec(callState.seconds);
                }, 1000);
            }

            function resetCallUiVisuals() {
                if (callState.timerId) {
                    clearInterval(callState.timerId);
                    callState.timerId = null;
                }
                localVideo.srcObject = null;
                localVideo.classList.add('d-none');
                remoteVideo.srcObject = null;
                remoteVideo.classList.add('d-none');
                pipPlaceholder.classList.remove('d-none');
                ringEl.classList.remove('calling');
                micBtn.disabled = true;
                camBtn.disabled = true;
                endBtn.disabled = true;
                startAudioBtn.disabled = false;
                startVideoBtn.disabled = false;
            }

            function renderOnlinePeers(peers) {
                if (!onlinePeersBar) return;
                var list = Array.isArray(peers) ? peers : [];
                if (!list.length) {
                    onlinePeersBar.innerHTML = '<i class="bi bi-broadcast text-secondary me-1"></i>Chưa phát hiện thiết bị khác đang mở (hãy mở thêm tab/app vai trò khác để gọi 2 chiều).';
                    return;
                }
                onlinePeersBar.innerHTML = '<div class="fw-semibold text-success mb-1"><i class="bi bi-broadcast me-1"></i>Thiết bị đang trực tuyến (' + list.length + '):</div>' +
                    '<div class="d-flex flex-wrap gap-1">' +
                    list.map(function (p) {
                        return '<button type="button" class="btn btn-xs btn-outline-success py-0 px-2 rounded-pill ss-online-peer-btn" ' +
                            'data-cid="' + (p.clientId || '') + '" data-role="' + (p.role || 'CuDan') + '" data-name="' + (p.displayName || p.role) + '" style="font-size:11px;">' +
                            '<span class="text-success">●</span> ' + (p.displayName || p.role) + ' (' + (p.role || '') + ')' +
                            '</button>';
                    }).join('') +
                    '</div>';

                onlinePeersBar.querySelectorAll('.ss-online-peer-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        callState.targetClientId = btn.getAttribute('data-cid') || '';
                        callState.targetRole = btn.getAttribute('data-role') || 'CuDan';
                        callState.targetName = btn.getAttribute('data-name') || 'Thiết bị SmartStay';
                        customTargetInput.value = callState.targetName;
                        partnerLabel.innerText = callState.targetName;
                    });
                });
            }

            function renderCallLogs(logs) {
                var arr = Array.isArray(logs) ? logs : [];
                countBadge.innerText = String(arr.length);
                if (!arr.length) {
                    historyList.innerHTML = '<div class="text-muted small">Chưa có lịch sử cuộc gọi nào.</div>';
                    return;
                }
                historyList.innerHTML = arr.slice(0, 8).map(function (c) {
                    var icon = (c.loaiCuocGoi === 'Video') ? 'bi-camera-video-fill text-primary' : 'bi-telephone-fill text-success';
                    var badgeStatus = c.trangThai ? (' • ' + c.trangThai) : '';
                    return '<div class="p-2 rounded-2 border bg-light-subtle">' +
                        '<div class="d-flex justify-content-between align-items-center fw-semibold">' +
                        '<span><i class="bi ' + icon + ' me-1"></i>' + (c.nguoiNhan || 'Ban Quản Lý') + '</span>' +
                        '<span class="badge bg-white text-dark border">' + fmtSec(c.thoiLuongGiay || 0) + '</span>' +
                        '</div>' +
                        '<div class="text-muted" style="font-size:11px;">' + (c.nguoiGoi || fullName) + ' → ' + (c.vaiTroNguoiNhan || 'QuanLy') + badgeStatus + '</div>' +
                        (c.noiDungTraoDoi ? '<div class="text-dark mt-1" style="font-size:11px;">"' + c.noiDungTraoDoi + '"</div>' : '') +
                        '</div>';
                }).join('');
            }

            async function refreshCallHistory() {
                try {
                    var res = await fetch('/api/sync/snapshot');
                    if (res.ok) {
                        var snap = await res.json();
                        renderCallLogs(snap.cuocGois || []);
                    }
                } catch (_) { }
            }

            async function saveCallRecord(statusLabel, durationSec, customNote) {
                if (callState.hasSavedCurrentCall) return;
                callState.hasSavedCurrentCall = true;
                var loai = callState.isVideo ? 'Video' : 'Thoại';
                var note = (customNote || noteInput.value || '').trim();
                try {
                    await fetch('/api/sync/cuoc-goi', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            CallId: callState.callId || undefined,
                            NguoiGoi: fullName + ' (' + serverRole + ')',
                            VaiTroNguoiGoi: serverRole,
                            NguoiNhan: callState.targetName,
                            VaiTroNguoiNhan: callState.targetRole,
                            LoaiCuocGoi: loai,
                            TrangThai: statusLabel || 'Đã kết nối',
                            ThoiLuongGiay: Math.max(0, durationSec || 0),
                            NoiDungTraoDoi: note || ('Cuộc gọi ' + loai.toLowerCase() + ' WebRTC trực tiếp (' + (statusLabel || 'Đã kết nối') + ')')
                        })
                    });
                    await refreshCallHistory();
                } catch (_) { }
            }

            var rtcManager = new window.SmartStayRtcManager({
                apiBase: '',
                prefix: 'mvc',
                role: serverRole,
                displayName: fullName,
                roomCode: roomCode,
                callbacks: {
                    onOnlinePeers: function (peers) {
                        renderOnlinePeers(peers);
                    },
                    onIncomingCall: function (pkt) {
                        callState.pendingIncomingPacket = pkt;
                        if (incomingNameEl) incomingNameEl.innerText = pkt.fromName || 'Cuộc gọi mới';
                        if (incomingRoleEl) {
                            incomingRoleEl.innerText = 'Vai trò: ' + (pkt.fromRole || 'CuDan') + (pkt.fromRoom ? (' • Phòng ' + pkt.fromRoom) : '');
                        }
                        if (incomingModeBadge) {
                            var isVid = String(pkt.callMode || '').toLowerCase() !== 'thoại';
                            incomingModeBadge.innerText = isVid ? 'Cuộc gọi Video HD đến (SignalR)' : 'Cuộc gọi Thoại đến (SignalR)';
                        }
                        if (incomingModalEl) {
                            bootstrap.Modal.getOrCreateInstance(incomingModalEl).show();
                        }
                    },
                    onCallAccepted: function (pkt) {
                        if (!callState.active) return;
                        callState.ringingOutgoing = false;
                        callState.connected = true;
                        if (pkt.fromName) {
                            callState.targetName = pkt.fromName;
                            partnerLabel.innerText = pkt.fromName;
                        }
                        statusBadge.className = 'badge bg-success rounded-pill px-3 py-1 mt-1';
                        statusBadge.innerText = (callState.isVideo ? 'Đang đàm thoại Video WebRTC' : 'Đang đàm thoại Thoại WebRTC') + ' • 00:00';
                        timerText.innerText = 'Đã nghe máy! Đang thiết lập WebRTC Peer-to-Peer...';
                        startCallTimer();
                    },
                    onCallRejected: function () {
                        var rejectedDuration = 0;
                        callState.ringingOutgoing = false;
                        callState.active = false;
                        callState.connected = false;
                        resetCallUiVisuals();
                        statusBadge.className = 'badge bg-danger rounded-pill px-3 py-1 mt-1';
                        statusBadge.innerText = 'Người nhận đã từ chối cuộc gọi';
                        timerText.innerText = 'Đã ghi nhận trạng thái Từ chối lên SmartStay Sync';
                        saveCallRecord('Từ chối', rejectedDuration, 'Người nhận từ chối cuộc gọi');
                    },
                    onCallEnded: function (pkt, hadActive) {
                        if (callState.pendingIncomingPacket && callState.pendingIncomingPacket.callId === pkt.callId) {
                            callState.pendingIncomingPacket = null;
                            if (incomingModalEl) {
                                var incInst = bootstrap.Modal.getInstance(incomingModalEl);
                                if (incInst) incInst.hide();
                            }
                        }
                        if (hadActive || callState.active) {
                            var dur = Math.max(callState.seconds, (pkt && pkt.payload && pkt.payload.durationSeconds) || 0);
                            var wasConnected = callState.connected;
                            callState.active = false;
                            callState.ringingOutgoing = false;
                            callState.connected = false;
                            resetCallUiVisuals();
                            statusBadge.className = 'badge bg-secondary rounded-pill px-3 py-1 mt-1';
                            statusBadge.innerText = 'Đối phương đã kết thúc • ' + fmtSec(dur);
                            timerText.innerText = 'Cuộc gọi đã đóng và đồng bộ lịch sử';
                            if (wasConnected) {
                                setTimeout(refreshCallHistory, 500);
                            }
                        }
                    },
                    onRemoteStream: function (stream) {
                        if (!stream) return;
                        remoteVideo.srcObject = stream;
                        remoteVideo.classList.remove('d-none');
                        remoteVideo.play().catch(function () { });
                        timerText.innerText = 'Đang truyền luồng Âm thanh & Hình ảnh WebRTC 2 chiều!';
                    },
                    onPeerStateChange: function (state) {
                        if (state === 'connected') {
                            timerText.innerText = 'Kết nối WebRTC Peer-to-Peer 2 chiều ổn định (Connected)';
                        } else if (state === 'failed') {
                            timerText.innerText = 'Cảnh báo: Không thiết lập được ICE WebRTC trực tiếp';
                        }
                    }
                }
            });

            rtcManager.start();
            window.addEventListener('beforeunload', function () {
                rtcManager.dispose();
            });

            async function beginCall(isVideo) {
                callState.active = true;
                callState.ringingOutgoing = true;
                callState.connected = false;
                callState.hasSavedCurrentCall = false;
                callState.isVideo = !!isVideo;
                callState.micOn = true;
                callState.camOn = !!isVideo;
                callState.seconds = 0;
                callState.targetName = (customTargetInput.value || callState.targetName).trim();

                partnerLabel.innerText = callState.targetName;
                statusBadge.className = 'badge bg-warning text-dark rounded-pill px-3 py-1 mt-1';
                statusBadge.innerText = 'Đang đổ chuông tới ' + callState.targetRole + '...';
                timerText.innerText = 'Đang gửi tín hiệu chuông SignalR & khởi tạo Media...';
                ringEl.classList.add('calling');
                micBtn.disabled = false;
                camBtn.disabled = !callState.isVideo;
                endBtn.disabled = false;
                startAudioBtn.disabled = true;
                startVideoBtn.disabled = true;

                var initRes = await rtcManager.initiateCall({
                    isVideo: callState.isVideo,
                    targetClientId: callState.targetClientId,
                    targetRole: callState.targetRole,
                    targetName: callState.targetName
                });
                callState.callId = initRes.callId;

                if (initRes.localStream && callState.isVideo) {
                    localVideo.srcObject = initRes.localStream;
                    localVideo.classList.remove('d-none');
                    pipPlaceholder.classList.add('d-none');
                }
                timerText.innerText = initRes.hardware
                    ? 'Đang đổ chuông • Mic/Camera thật đã sẵn sàng, chờ người nhận bấm Chấp nhận...'
                    : 'Đang đổ chuông • Chờ người nhận bấm Chấp nhận (đang dùng luồng Media WebRTC dự phòng)...';
            }

            async function finishCall() {
                if (!callState.active) return;
                var dur = callState.connected ? Math.max(callState.seconds, 1) : 0;
                var wasConnected = callState.connected;
                callState.active = false;
                callState.ringingOutgoing = false;
                callState.connected = false;

                resetCallUiVisuals();
                await rtcManager.endCurrentCall(dur);

                statusBadge.className = 'badge bg-secondary rounded-pill px-3 py-1 mt-1';
                statusBadge.innerText = wasConnected
                    ? ('Đã kết thúc • ' + fmtSec(dur))
                    : 'Đã hủy cuộc gọi trước khi nghe máy';
                timerText.innerText = 'Đã lưu lịch sử cuộc gọi thực tế lên SmartStay Sync';
                await saveCallRecord(wasConnected ? 'Đã kết nối' : 'Hủy cuộc gọi', dur);
            }

            if (incomingAcceptBtn) {
                incomingAcceptBtn.addEventListener('click', async function () {
                    var pkt = callState.pendingIncomingPacket;
                    callState.pendingIncomingPacket = null;
                    if (incomingModalEl) {
                        var incInst = bootstrap.Modal.getInstance(incomingModalEl);
                        if (incInst) incInst.hide();
                    }
                    if (!pkt) return;

                    var isVid = String(pkt.callMode || '').toLowerCase() !== 'thoại';
                    callState.active = true;
                    callState.ringingOutgoing = false;
                    callState.connected = true;
                    callState.hasSavedCurrentCall = false;
                    callState.callId = pkt.callId;
                    callState.isVideo = isVid;
                    callState.micOn = true;
                    callState.camOn = isVid;
                    callState.targetClientId = pkt.fromClientId || '';
                    callState.targetRole = pkt.fromRole || 'CuDan';
                    callState.targetName = pkt.fromName || 'Người gọi SmartStay';

                    customTargetInput.value = callState.targetName;
                    partnerLabel.innerText = callState.targetName;
                    statusBadge.className = 'badge bg-success rounded-pill px-3 py-1 mt-1';
                    statusBadge.innerText = (isVid ? 'Đang đàm thoại Video WebRTC' : 'Đang đàm thoại Thoại WebRTC') + ' • 00:00';
                    timerText.innerText = 'Đã chấp nhận! Đang kết nối luồng Media WebRTC 2 chiều...';
                    ringEl.classList.add('calling');
                    micBtn.disabled = false;
                    camBtn.disabled = !isVid;
                    endBtn.disabled = false;
                    startAudioBtn.disabled = true;
                    startVideoBtn.disabled = true;

                    bootstrap.Modal.getOrCreateInstance(callModalEl).show();
                    var accRes = await rtcManager.acceptIncomingCall(pkt);
                    if (accRes.localStream && isVid) {
                        localVideo.srcObject = accRes.localStream;
                        localVideo.classList.remove('d-none');
                        pipPlaceholder.classList.add('d-none');
                    }
                    startCallTimer();
                    refreshCallHistory();
                });
            }

            if (incomingRejectBtn) {
                incomingRejectBtn.addEventListener('click', async function () {
                    var pkt = callState.pendingIncomingPacket;
                    callState.pendingIncomingPacket = null;
                    if (incomingModalEl) {
                        var incInst = bootstrap.Modal.getInstance(incomingModalEl);
                        if (incInst) incInst.hide();
                    }
                    if (pkt) {
                        await rtcManager.rejectIncomingCall(pkt);
                    }
                });
            }

            callModalEl.querySelectorAll('.ss-call-preset').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    callState.targetClientId = '';
                    callState.targetRole = btn.getAttribute('data-target-role') || 'QuanLy';
                    callState.targetName = btn.getAttribute('data-target-name') || 'Ban Quản Lý';
                    customTargetInput.value = callState.targetName;
                    partnerLabel.innerText = callState.targetName;
                });
            });

            startAudioBtn.addEventListener('click', function () { beginCall(false); });
            startVideoBtn.addEventListener('click', function () { beginCall(true); });
            endBtn.addEventListener('click', function () { finishCall(); });

            micBtn.addEventListener('click', function () {
                callState.micOn = !callState.micOn;
                micBtn.innerHTML = callState.micOn ? '<i class="bi bi-mic-fill"></i> Mic Bật' : '<i class="bi bi-mic-mute-fill text-danger"></i> Mic Tắt';
                rtcManager.setMicEnabled(callState.micOn);
            });

            camBtn.addEventListener('click', function () {
                callState.camOn = !callState.camOn;
                camBtn.innerHTML = callState.camOn ? '<i class="bi bi-camera-video"></i> Cam Bật' : '<i class="bi bi-camera-video-off text-danger"></i> Cam Tắt';
                rtcManager.setCamEnabled(callState.camOn);
                if (callState.camOn && rtcManager.localStream) {
                    localVideo.classList.remove('d-none');
                    pipPlaceholder.classList.add('d-none');
                } else {
                    localVideo.classList.add('d-none');
                    pipPlaceholder.classList.remove('d-none');
                }
            });

            callModalEl.addEventListener('hidden.bs.modal', function () {
                if (callState.active) {
                    finishCall();
                } else {
                    resetCallUiVisuals();
                }
            });

            window.openSmartStayCallModal = function (targetRole, targetName, autoStartVideo) {
                callState.targetClientId = '';
                if (targetRole) callState.targetRole = targetRole;
                if (targetName) {
                    callState.targetName = targetName;
                    customTargetInput.value = targetName;
                    partnerLabel.innerText = targetName;
                }
                refreshCallHistory();
                rtcManager.pollOnce();
                var modal = bootstrap.Modal.getOrCreateInstance(callModalEl);
                modal.show();
                if (autoStartVideo === true) {
                    beginCall(true);
                } else if (autoStartVideo === false) {
                    beginCall(false);
                }
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
