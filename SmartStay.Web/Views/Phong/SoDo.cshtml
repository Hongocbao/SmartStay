@{
    ViewData["Title"] = "Sơ đồ Phòng theo Tầng (Room Matrix) - SmartStay";
}

<style>
    .status-filter-btn {
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: all 0.18s ease;
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.35rem 0.78rem;
        background: #F8FAFC;
    }

    .status-filter-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
    }

    .status-filter-btn.active {
        box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px var(--status-ring, #2563EB);
        font-weight: 700;
    }
</style>

<!-- Alert thông báo tương tác -->
<div id="roomAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm mb-4" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="roomAlertText">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('roomAlert').classList.add('d-none')"></button>
</div>

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <!-- Nút bấm lọc Trạng thái tương tác -->
        <div class="d-flex flex-wrap align-items-center gap-2" role="group" aria-label="Lọc phòng theo trạng thái">
            <span class="fs-8 fw-bold text-muted text-uppercase me-1">TRẠNG THÁI:</span>
            <button type="button" class="status-filter-btn active" data-status-btn="all" style="--status-ring:#4F46E5; background:#F1F5F9; color:#1E293B; border-color:#CBD5E1;" onclick="filterByStatus('all')">
                <i class="bi bi-grid-fill fs-9 text-primary"></i> Tất cả (<span id="countAll">8</span>)
            </button>
            <button type="button" class="status-filter-btn badge-status badge-trong" data-status-btn="trong" style="--status-ring:#10B981;" onclick="filterByStatus('trong')">
                <i class="bi bi-circle-fill fs-9"></i> Trống (<span id="countTrong">2</span>)
            </button>
            <button type="button" class="status-filter-btn badge-status badge-dango" data-status-btn="dango" style="--status-ring:#2563EB;" onclick="filterByStatus('dango')">
                <i class="bi bi-circle-fill fs-9"></i> Đang ở (<span id="countDangO">3</span>)
            </button>
            <button type="button" class="status-filter-btn" data-status-btn="oghep" style="--status-ring:#7C3AED; background:#F5F3FF; color:#7C3AED; border-color:#DDD6FE;" onclick="filterByStatus('oghep')">
                <i class="bi bi-people-fill"></i> Ở ghép còn chỗ (<span id="countOGhep">1</span> phòng)
            </button>
            <button type="button" class="status-filter-btn badge-status badge-baotri" data-status-btn="baotri" style="--status-ring:#F59E0B;" onclick="filterByStatus('baotri')">
                <i class="bi bi-circle-fill fs-9"></i> Bảo trì (<span id="countBaoTri">1</span>)
            </button>
            <button type="button" class="status-filter-btn badge-status badge-dadat" data-status-btn="dadat" style="--status-ring:#8B5CF6;" onclick="filterByStatus('dadat')">
                <i class="bi bi-circle-fill fs-9"></i> Đã đặt (<span id="countDaDat">1</span>)
            </button>
        </div>

        <!-- Bộ lọc Tòa nhà & Nút thêm phòng -->
        <div class="d-flex flex-wrap gap-2">
            <select id="buildingFilter" class="form-select form-select-sm rounded-3 fw-semibold" style="width:auto;" onchange="filterBuilding(this.value)">
                <option value="all" selected>Tất cả tòa nhà (A &amp; B)</option>
                <option value="A">Tòa nhà A - Co-Living SmartStay</option>
                <option value="B">Tòa nhà B - Boutique Apartments</option>
            </select>
            <button type="button" class="btn btn-sm btn-primary rounded-3 text-nowrap shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddRoom">
                <i class="bi bi-plus-lg me-1"></i> Thêm phòng mới
            </button>
        </div>
    </div>
</div>

<!-- Khung hiển thị thông tin tổng hợp khi bấm chọn nút Trạng thái -->
<div id="statusInfoPanel" class="card-custom mb-4 d-none border border-primary-subtle">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span id="statusInfoBadge" class="badge badge-status badge-trong">Trạng thái</span>
                <h6 id="statusInfoTitle" class="fw-bold mb-0 text-slate-900">Thông tin nhóm phòng</h6>
            </div>
            <div id="statusInfoMeta" class="fs-8 text-muted mt-1"></div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 text-nowrap" onclick="filterByStatus('all')">
            <i class="bi bi-x-circle me-1"></i> Hiện tất cả phòng
        </button>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="fs-8 text-muted text-uppercase">
                    <th>Phòng</th>
                    <th>Tòa / Tầng</th>
                    <th>Thông tin chi tiết / Cư dân</th>
                    <th>Giá thuê/tháng</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody id="statusInfoBody"></tbody>
        </table>
    </div>
</div>

<!-- Thông báo rỗng khi không có phòng khớp cả trạng thái & tòa nhà -->
<div id="emptyRoomFilterState" class="card-custom mb-4 text-center py-4 d-none">
    <i class="bi bi-search fs-2 text-muted d-block mb-2"></i>
    <div class="fw-bold text-slate-800 mb-1">Không có phòng nào phù hợp bộ lọc hiện tại</div>
    <p class="fs-8 text-muted mb-3">Hãy thử chọn trạng thái khác hoặc chuyển sang "Tất cả tòa nhà".</p>
    <button type="button" class="btn btn-sm btn-outline-primary rounded-3" onclick="resetRoomFilters()">
        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
    </button>
</div>

<!-- Ma Trận Phòng Tầng 3 -->
