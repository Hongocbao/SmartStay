        <div class="col-xl-3 col-md-4 col-sm-6 room-card-col" id="card-p306" data-room="P.306" data-status="baotri" data-floor-label="Tòa A - Tầng 3" data-summary="Đang sơn nước &amp; bảo dưỡng định kỳ (Tạm ngưng cho thuê)" data-price="3.500.000 đ">
