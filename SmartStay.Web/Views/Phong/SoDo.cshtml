        <span class="fs-8 text-muted">Lấp đầy: 12/14 (85.7%)</span>
    </div>
    <div class="row g-3" id="toaBRooms">
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p201" data-room="P.201">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" onclick="openRoomModal('P.201', 'Nguyễn Dương Bảo', '0902234567', '3.800.000 đ', 'Đang ở', 'Boutique Studio • 25 m²', '93%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
