@{
    ViewData["Title"] = "Sơ đồ Phòng theo Tầng (Room Matrix) - SmartStay";
}

<!-- Alert thông báo tương tác -->
<div id="roomAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm mb-4" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="roomAlertText">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('roomAlert').classList.add('d-none')"></button>
</div>

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <!-- Chú thích màu sắc trạng thái -->
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="fs-8 fw-bold text-muted text-uppercase">TRẠNG THÁI:</span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-trong"><i class="bi bi-circle-fill me-1 fs-9"></i> Trống (<span id="countTrong">2</span>)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-dango"><i class="bi bi-circle-fill me-1 fs-9"></i> Đang ở (<span id="countDangO">28</span>)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-baotri"><i class="bi bi-circle-fill me-1 fs-9"></i> Bảo trì (1)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-dadat"><i class="bi bi-circle-fill me-1 fs-9"></i> Đã đặt (1)</span>
            </div>
        </div>

        <!-- Bộ lọc Tòa nhà & Nút thêm phòng -->
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm rounded-3 fw-semibold">
                <option value="1">Tòa nhà A - Co-Living SmartStay</option>
                <option value="2">Tòa nhà B - Boutique Apartments</option>
            </select>
            <button class="btn btn-sm btn-primary rounded-3 text-nowrap shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddRoom">
                <i class="bi bi-plus-lg me-1"></i> Thêm phòng mới
            </button>
        </div>
    </div>
</div>

<!-- Ma Trận Phòng Tầng 3 -->
<div class="card-custom mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-layers-fill text-primary me-2"></i>TẦNG 3 (8 Phòng)</h6>
        <span class="fs-8 text-muted" id="statTang3">Lấp đầy: 7/8 (87.5%)</span>
    </div>
    <div class="row g-3" id="tang3Rooms">
        <!-- P.301 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" onclick="openRoomModal('P.301', 'Trần Văn Nam', '0912345678', '3.500.000 đ', 'Đang ở', 'Studio 1 giường • 22.5 m²', '94%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.301</span>
                    <span class="badge badge-status badge-dango">Đang ở</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-semibold text-truncate"><i class="bi bi-person-fill text-muted me-1"></i> Trần Văn Nam</div>
                    <div class="fs-8 text-primary fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.302 -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p302">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #10B981 !important; cursor: pointer;" onclick="openRoomModal('P.302', '', '', '3.500.000 đ', 'Trống', 'Studio 1 giường • 22.5 m²', '90%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.302</span>
                    <span class="badge badge-status badge-trong">Trống</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Sẵn sàng cho thuê</div>
                    <div class="fs-8 text-muted fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.305 (Phòng của Hồ Ngọc Bảo) -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p305">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #4F46E5 !important; cursor: pointer; background: #FAF5FF !important;" onclick="openRoomModal('P.305', 'Hồ Ngọc Bảo', '0901234567', '3.500.000 đ', 'Đang ở', 'Studio Cao Cấp Co-Living • 22.5 m²', '92%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.305 <i class="bi bi-star-fill text-warning fs-8"></i></span>
                    <span class="badge badge-status badge-dango" id="badge-p305">Đang ở</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-bold text-slate-900 text-truncate"><i class="bi bi-person-badge-fill text-primary me-1"></i> Hồ Ngọc Bảo</div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="fs-8 text-primary fw-bold">3.500.000 đ</span>
                        <span class="badge bg-danger-subtle text-danger fs-9">Có sự cố</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- P.306 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #F59E0B !important; cursor: pointer;" onclick="openRoomModal('P.306', '', '', '3.500.000 đ', 'Bảo trì', 'Studio 1 giường • 22.5 m²', '88%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.306</span>
                    <span class="badge badge-status badge-baotri">Bảo trì</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-warning fw-bold"><i class="bi bi-wrench-adjustable me-1"></i> Đang sơn nước & dọn</div>
                    <div class="fs-8 text-muted fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ma Trận Phòng Tầng 4 -->
<div class="card-custom mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-layers-fill text-primary me-2"></i>TẦNG 4 (8 Phòng)</h6>
        <span class="fs-8 text-muted">Lấp đầy: 8/8 (100%)</span>
    </div>
    <div class="row g-3">
        <!-- P.401 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" onclick="openRoomModal('P.401', 'Trần Hoàng Gia Bảo + 1 người', '0903234567', '5.000.000 đ', 'Đang ở', 'Deluxe 2 giường tầng • 30 m²', '95%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.401</span>
                    <span class="badge badge-status badge-dango">Đang ở</span>
                </div>
                <p class="text-muted fs-8 mb-2">Deluxe 2 giường tầng • 30 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-semibold text-truncate"><i class="bi bi-people-fill text-muted me-1"></i> Trần Hoàng Gia Bảo</div>
                    <div class="fs-8 text-primary fw-bold mt-1">5.000.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.402 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #8B5CF6 !important; cursor: pointer;" onclick="openRoomModal('P.402', 'Lê Minh Khôi', '0919223344', '5.000.000 đ', 'Đã đặt', 'Deluxe 2 giường tầng • 30 m²', '91%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.402</span>
                    <span class="badge badge-status badge-dadat">Đã đặt</span>
                </div>
                <p class="text-muted fs-8 mb-2">Deluxe 2 giường tầng • 30 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-purple fw-bold"><i class="bi bi-calendar-check me-1"></i> Nhận phòng 05/11</div>
                    <div class="fs-8 text-muted fw-bold mt-1">Cọc: 10.000.000 đ</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL CHI TIẾT PHÒNG TƯƠNG TÁC ================= -->
<div class="modal fade" id="roomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-slate-900" id="mRoomTitle">Chi tiết Phòng P.305 - Tòa nhà A</h5>
                    <p class="text-muted fs-8 mb-0" id="mRoomSub">Loại: Studio Co-Living 1 Giường • Diện tích: 22.5 m²</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <h6 class="fw-bold fs-7 mb-2 text-primary"><i class="bi bi-person-lines-fill me-1"></i> THÔNG TIN CƯ DÂN & HỢP ĐỒNG</h6>
                            <p class="mb-1 fw-bold fs-6" id="mResidentName">Hồ Ngọc Bảo (MSSV: 2380600133)</p>
                            <p class="mb-1 text-muted fs-8" id="mResidentPhone"><i class="bi bi-telephone me-1"></i> 0901234567</p>
                            <p class="mb-1 text-muted fs-8"><i class="bi bi-calendar-event me-1"></i> Hợp đồng: 01/08/2026 - 31/07/2027</p>
                            <p class="mb-0 text-muted fs-8"><i class="bi bi-cash-stack me-1"></i> Tiền thuê: <strong id="mRentPrice">3.500.000 đ</strong>/tháng</p>
                            
                            <div class="mt-3 pt-2 border-top">
                                <span class="badge bg-success-subtle text-success fs-8" id="mRoomBadge">Đang ở</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <h6 class="fw-bold fs-7 mb-2 text-success"><i class="bi bi-lock-fill me-1"></i> KHÓA THÔNG MINH IOT</h6>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success text-white"><i class="bi bi-wifi"></i> Online</span>
                                <span class="fs-8 text-muted">Pin: <strong class="text-dark" id="mLockBattery">92%</strong></span>
                                <span class="badge bg-light text-dark border">RFID + Mã PIN</span>
                            </div>
                            <div class="fs-8 text-muted mb-3">Mã khóa: <strong>LOCK-A-305</strong> • Mật mã mở: <code>305888</code></div>
                            
                            <button class="btn btn-sm btn-outline-success w-100 rounded-3 mb-2" onclick="unlockDoorRemote()">
                                <i class="bi bi-unlock-fill me-1"></i> Gửi Lệnh Mở Khóa Từ Xa (Remote Unlock)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer px-4 pb-4 pt-0 border-0 d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-primary rounded-3 btn-sm" onclick="promptElectricWater()">
                        <i class="bi bi-speedometer2 me-1"></i> Ghi chỉ số điện nước
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <a href="/HoaDon/Index" class="btn btn-outline-secondary rounded-3 btn-sm"><i class="bi bi-receipt me-1"></i> Lập hóa đơn</a>
                    <a href="/SuCo/Kanban" class="btn btn-outline-warning rounded-3 btn-sm"><i class="bi bi-tools me-1"></i> Báo sự cố</a>
                    <button type="button" class="btn btn-danger rounded-3 btn-sm shadow-sm" onclick="performCheckout()">
                        <i class="bi bi-box-arrow-right me-1"></i> Thực hiện Check-out
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL THÊM PHÒNG MỚI ================= -->
<div class="modal fade" id="modalAddRoom" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <h5 class="modal-title fw-bold text-slate-900">Thêm Căn Hộ / Phòng Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addRoomForm" onsubmit="handleAddRoom(event)">
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Mã số phòng</label>
                        <input type="text" id="arCode" class="form-control rounded-3" placeholder="Ví dụ: P.308" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Tầng</label>
                            <select id="arFloor" class="form-select rounded-3">
                                <option value="3">Tầng 3</option>
                                <option value="4">Tầng 4</option>
                                <option value="5">Tầng 5</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Diện tích (m²)</label>
                            <input type="number" id="arArea" class="form-control rounded-3" value="25" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Loại phòng</label>
                        <select id="arType" class="form-select rounded-3">
                            <option value="Studio 1 giường">Studio 1 giường Co-Living</option>
                            <option value="Studio Ban công">Studio Ban công View Thoáng</option>
                            <option value="Deluxe 2 giường">Deluxe 2 giường tầng</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Giá thuê hàng tháng (VNĐ)</label>
                        <input type="text" id="arPrice" class="form-control rounded-3" value="3.500.000 đ" required>
                    </div>
                    <div class="modal-footer px-0 pb-0 pt-3 border-0">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                            <i class="bi bi-plus-circle me-1"></i> Lưu Phòng Mới
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    let currentSelectedRoom = 'P.305';

    function openRoomModal(roomCode, residentName, phone, price, status, sub, battery) {
        currentSelectedRoom = roomCode;
        document.getElementById('mRoomTitle').innerText = `Chi tiết Phòng ${roomCode} - Tòa nhà A`;
        document.getElementById('mRoomSub').innerText = sub;
        document.getElementById('mRentPrice').innerText = price;
        document.getElementById('mLockBattery').innerText = battery;

        const resNameEl = document.getElementById('mResidentName');
        const resPhoneEl = document.getElementById('mResidentPhone');
        const badgeEl = document.getElementById('mRoomBadge');

        if (status === 'Trống') {
            resNameEl.innerText = 'Phòng đang trống (Chưa có cư dân)';
            resPhoneEl.innerText = 'Liên hệ BQL để ký hợp đồng mới';
            badgeEl.className = 'badge badge-status badge-trong';
            badgeEl.innerText = 'Phòng Trống';
        } else if (status === 'Bảo trì') {
            resNameEl.innerText = 'Đang bảo dưỡng định kỳ & sơn sửa';
            resPhoneEl.innerText = 'Kỹ thuật viên phụ trách: Trần Văn Tuấn';
            badgeEl.className = 'badge badge-status badge-baotri';
            badgeEl.innerText = 'Đang Bảo Trì';
        } else {
            resNameEl.innerText = residentName;
            resPhoneEl.innerHTML = `<i class="bi bi-telephone me-1"></i> ${phone}`;
            badgeEl.className = 'badge badge-status badge-dango';
            badgeEl.innerText = 'Đang ở';
        }

        new bootstrap.Modal(document.getElementById('roomModal')).show();
    }

    function unlockDoorRemote() {
        showRoomAlert(`Đã phát lệnh mở khóa qua WiFi IoT tới phòng ${currentSelectedRoom}! Cửa đã được mở.`);
    }

    function promptElectricWater() {
        const dien = prompt(`Nhập chỉ số điện mới cho phòng ${currentSelectedRoom} (kWh):`, "1540");
        if (dien) {
            const nuoc = prompt(`Nhập chỉ số nước mới cho phòng ${currentSelectedRoom} (m³):`, "92");
            if (nuoc) {
                showRoomAlert(`Đã ghi nhận chỉ số phòng ${currentSelectedRoom}: Điện ${dien} kWh, Nước ${nuoc} m³. Hệ thống đã cập nhật vào kỳ tính phí tháng 10!`);
            }
        }
    }

    function performCheckout() {
        if (confirm(`Bạn có chắc chắn muốn làm thủ tục Check-out trả phòng cho phòng ${currentSelectedRoom}? Hệ thống sẽ xuất biên bản bàn giao tài sản và chuyển trạng thái phòng sang [Trống].`)) {
            const modal = bootstrap.Modal.getInstance(document.getElementById('roomModal'));
            if (modal) modal.hide();

            if (currentSelectedRoom === 'P.305') {
                const card = document.getElementById('card-p305');
                if (card) {
                    card.style.background = '#FFFFFF';
                    card.style.borderLeft = '5px solid #10B981 !important';
                    document.getElementById('badge-p305').className = 'badge badge-status badge-trong';
                    document.getElementById('badge-p305').innerText = 'Trống';
                }
            }
            document.getElementById('countDangO').innerText = '27';
            document.getElementById('countTrong').innerText = '3';
            fetch('/api/sync/cap-nhat-phong', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ KyHieuPhong: currentSelectedRoom, TrangThai: 'Trống' })
            }).catch(() => {});
            showRoomAlert(`Thực hiện Check-out thành công cho phòng ${currentSelectedRoom}! Đã đồng bộ Realtime trạng thái [Trống] sang Android & Web App.`);
        }
    }

    function handleAddRoom(e) {
        e.preventDefault();
        const code = document.getElementById('arCode').value;
        const type = document.getElementById('arType').value;
        const area = document.getElementById('arArea').value;
        const price = document.getElementById('arPrice').value;

        const newCard = `
            <div class="col-xl-3 col-md-4 col-sm-6">
                <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #10B981 !important; cursor: pointer;" onclick="openRoomModal('${code}', '', '', '${price}', 'Trống', '${type} • ${area} m²', '95%')">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold fs-5 text-slate-900">${code}</span>
                        <span class="badge badge-status badge-trong">Trống</span>
                    </div>
                    <p class="text-muted fs-8 mb-2">${type} • ${area} m²</p>
                    <div class="pt-2 border-top">
                        <div class="fs-8 text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Mới thêm • Sẵn sàng</div>
                        <div class="fs-8 text-muted fw-bold mt-1">${price}/tháng</div>
                    </div>
                </div>
            </div>
        `;

        document.getElementById('tang3Rooms').insertAdjacentHTML('beforeend', newCard);
        bootstrap.Modal.getInstance(document.getElementById('modalAddRoom')).hide();
        document.getElementById('countTrong').innerText = '3';
        showRoomAlert(`Đã thêm thành công căn hộ mới ${code} vào sơ đồ phòng tầng 3!`);
    }

    function showRoomAlert(msg) {
        const alertBox = document.getElementById('roomAlert');
        document.getElementById('roomAlertText').innerText = msg;
        alertBox.classList.remove('d-none');
        alertBox.classList.add('show');
        setTimeout(() => {
            alertBox.classList.remove('show');
            alertBox.classList.add('d-none');
        }, 5000);
    }
</script>
