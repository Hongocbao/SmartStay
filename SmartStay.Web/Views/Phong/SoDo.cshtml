@{
    ViewData["Title"] = "Sơ đồ Phòng theo Tầng (Room Matrix) - SmartStay";
}

<!-- Alert thông báo tương tác -->
<div id="roomAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm mb-4" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="roomAlertText">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('roomAlert').classList.add('d-none')"></button>
</div>

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <!-- Chú thích màu sắc trạng thái -->
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="fs-8 fw-bold text-muted text-uppercase">TRẠNG THÁI:</span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-trong"><i class="bi bi-circle-fill me-1 fs-9"></i> Trống (<span id="countTrong">2</span>)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-dango"><i class="bi bi-circle-fill me-1 fs-9"></i> Đang ở (<span id="countDangO">28</span>)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-purple-subtle text-purple border px-2 py-1 fs-8 rounded-3" style="background:#F5F3FF; color:#7C3AED;">
                    <i class="bi bi-people-fill me-1"></i> Ở ghép còn chỗ (1 phòng)
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-baotri"><i class="bi bi-circle-fill me-1 fs-9"></i> Bảo trì (1)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-dadat"><i class="bi bi-circle-fill me-1 fs-9"></i> Đã đặt (1)</span>
            </div>
        </div>

        <!-- Bộ lọc Tòa nhà & Nút thêm phòng -->
        <div class="d-flex flex-wrap gap-2">
            <select id="buildingFilter" class="form-select form-select-sm rounded-3 fw-semibold" onchange="filterBuilding(this.value)">
                <option value="all" selected>Tất cả tòa nhà (A &amp; B)</option>
                <option value="A">Tòa nhà A - Co-Living SmartStay</option>
                <option value="B">Tòa nhà B - Boutique Apartments</option>
            </select>
            <button class="btn btn-sm btn-primary rounded-3 text-nowrap shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddRoom">
                <i class="bi bi-plus-lg me-1"></i> Thêm phòng mới
            </button>
        </div>
    </div>
</div>

<!-- Ma Trận Phòng Tầng 3 -->
<div class="card-custom mb-4 room-building-sec" id="sec-tang3" data-building="A">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-layers-fill text-primary me-2"></i>TÒA A - TẦNG 3 (8 Phòng)</h6>
        <span class="fs-8 text-muted" id="statTang3">Lấp đầy: 7/8 (87.5%)</span>
    </div>
    <div class="row g-3" id="tang3Rooms">
        <!-- P.301 -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p301" data-room="P.301">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" onclick="openRoomModal('P.301', 'Trần Văn Nam', '0912345678', '3.500.000 đ', 'Đang ở', 'Studio Nguyên Căn • 22.5 m²', '94%', 'Nguyên căn (1/1)', 'Nam/Nữ tự do', [{bed:'Giường 1', name:'Trần Văn Nam', phone:'0912345678', status:'Đang ở'}])">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold fs-5 text-slate-900">P.301</span>
                    <span class="badge badge-status badge-dango" id="badge-p301">Nguyên căn (1/1)</span>
                </div>
                <div class="d-flex align-items-center gap-1 mb-2">
                    <span class="badge bg-light text-muted border fs-9">Studio</span>
                    <span class="badge bg-light text-muted border fs-9">22.5 m²</span>
                    <span class="badge bg-light text-primary border fs-9"><i class="bi bi-gender-ambiguous"></i> Tự do</span>
                </div>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-semibold text-truncate"><i class="bi bi-person-fill text-muted me-1"></i> Trần Văn Nam</div>
                    <div class="fs-8 text-primary fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.302 -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p302" data-room="P.302">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #10B981 !important; cursor: pointer;" onclick="openRoomModal('P.302', '', '', '3.500.000 đ', 'Trống', 'Studio Nguyên Căn • 22.5 m²', '90%', 'Trống hoàn toàn (0/1)', 'Nam/Nữ tự do', [{bed:'Giường 1', name:'Chưa có cư dân', phone:'', status:'Trống'}])">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold fs-5 text-slate-900">P.302</span>
                    <span class="badge badge-status badge-trong" id="badge-p302">Trống (0/1)</span>
                </div>
                <div class="d-flex align-items-center gap-1 mb-2">
                    <span class="badge bg-light text-muted border fs-9">Studio</span>
                    <span class="badge bg-light text-muted border fs-9">22.5 m²</span>
                    <span class="badge bg-light text-success border fs-9"><i class="bi bi-check2"></i> Sẵn sàng cho thuê</span>
                </div>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-success fw-bold"><i class="bi bi-door-open me-1"></i> Thuê nguyên căn</div>
                    <div class="fs-8 text-muted fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.305 (Phòng Ở Ghép Co-Living) -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p305" data-room="P.305">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #7C3AED !important; cursor: pointer; background: #FAF5FF !important;" onclick="openRoomModal('P.305', 'Hồ Ngọc Bảo + 1 bạn', '0901234567', '3.500.000 đ', 'Ở ghép', 'Co-Living 3 giường • 22.5 m²', '92%', 'Ở ghép (2/3 Chỗ - Còn 1 giường)', 'Phòng Nam', [{bed:'Giường A (Trưởng phòng)', name:'Hồ Ngọc Bảo', phone:'0901234567', status:'Đang ở'}, {bed:'Giường B', name:'Nguyễn Dương Bảo', phone:'0902345678', status:'Đang ở'}, {bed:'Giường C', name:'Trống - Sẵn sàng ghép', phone:'', status:'Trống'}], true)">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold fs-5 text-slate-900">P.305 <i class="bi bi-star-fill text-warning fs-8"></i></span>
                    <span class="badge bg-purple text-white px-2 py-1 fs-9 rounded-pill" style="background:#7C3AED;" id="badge-p305">
                        <i class="bi bi-people-fill me-1"></i> Ở ghép 2/3 (Còn 1 chỗ)
                    </span>
                </div>
                <div class="d-flex align-items-center gap-1 mb-2">
                    <span class="badge bg-primary-subtle text-primary border fs-9"><i class="bi bi-gender-male"></i> Nam</span>
                    <span class="badge bg-light text-muted border fs-9">3 Giường</span>
                    <span class="badge bg-danger-subtle text-danger border fs-9"><i class="bi bi-exclamation-triangle"></i> Có sự cố</span>
                </div>

                <!-- Thanh slot chỗ ngủ trực quan -->
                <div class="p-2 rounded-2 bg-white border mb-2 fs-9">
                    <div class="d-flex justify-content-between text-muted mb-1">
                        <span>Tiến độ chỗ ở:</span>
                        <strong class="text-purple" style="color:#7C3AED;">2/3 Giường (Trống 1)</strong>
                    </div>
                    <div class="d-flex gap-1">
                        <div class="flex-fill bg-primary rounded text-center text-white py-1" style="font-size:9px;" title="Giường A: Hồ Ngọc Bảo">A: Bảo</div>
                        <div class="flex-fill bg-info text-white rounded text-center py-1" style="font-size:9px;" title="Giường B: Nguyễn Dương Bảo">B: D.Bảo</div>
                        <div class="flex-fill border border-success border-2 rounded text-center text-success fw-bold py-1 bg-success-subtle" style="font-size:9px;" title="Giường C: Đang trống đón bạn mới">C: TRỐNG</div>
                    </div>
                </div>

                <div class="pt-2 border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fs-8 fw-bold text-slate-900 text-truncate"><i class="bi bi-shield-check text-success me-1"></i> Cần cư dân duyệt</div>
                        <span class="badge bg-warning-subtle text-warning fs-9">1 đơn chờ</span>
                    </div>
                    <div class="fs-8 text-primary fw-bold mt-1">3.500.000 đ (~1.166k/giường)</div>
                </div>
            </div>
        </div>

        <!-- P.306 -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p306" data-room="P.306">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #F59E0B !important; cursor: pointer;" onclick="openRoomModal('P.306', '', '', '3.500.000 đ', 'Bảo trì', 'Studio 1 giường • 22.5 m²', '88%', 'Đang bảo trì', 'Tự do', [])">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold fs-5 text-slate-900">P.306</span>
                    <span class="badge badge-status badge-baotri" id="badge-p306">Bảo trì</span>
                </div>
                <div class="d-flex align-items-center gap-1 mb-2">
                    <span class="badge bg-light text-muted border fs-9">Studio</span>
                    <span class="badge bg-light text-muted border fs-9">22.5 m²</span>
                </div>
                <p class="text-muted fs-8 mb-2">Đang sơn nước & bảo dưỡng định kỳ</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-warning fw-bold"><i class="bi bi-wrench-adjustable me-1"></i> Tạm ngưng cho thuê</div>
                    <div class="fs-8 text-muted fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ma Trận Phòng Tầng 4 -->
<div class="card-custom mb-4 room-building-sec" id="sec-tang4" data-building="A">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-layers-fill text-primary me-2"></i>TÒA A - TẦNG 4 (8 Phòng)</h6>
        <span class="fs-8 text-muted">Lấp đầy: 8/8 (100%)</span>
    </div>
    <div class="row g-3" id="tang4Rooms">
        <!-- P.401 -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p401" data-room="P.401">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" onclick="openRoomModal('P.401', 'Trần Hoàng Gia Bảo + 1 người', '0903234567', '5.000.000 đ', 'Đang ở', 'Deluxe 2 giường tầng • 30 m²', '95%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.401</span>
                    <span class="badge badge-status badge-dango" id="badge-p401">Đang ở</span>
                </div>
                <p class="text-muted fs-8 mb-2">Deluxe 2 giường tầng • 30 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-semibold text-truncate"><i class="bi bi-people-fill text-muted me-1"></i> Trần Hoàng Gia Bảo</div>
                    <div class="fs-8 text-primary fw-bold mt-1">5.000.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.402 -->
        <div class="col-xl-3 col-md-4 col-sm-6" id="card-p402" data-room="P.402">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #8B5CF6 !important; cursor: pointer;" onclick="openRoomModal('P.402', 'Lê Minh Khôi', '0919223344', '5.000.000 đ', 'Đã đặt', 'Deluxe 2 giường tầng • 30 m²', '91%')">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.402</span>
                    <span class="badge badge-status badge-dadat" id="badge-p402">Đã đặt</span>
                </div>
                <p class="text-muted fs-8 mb-2">Deluxe 2 giường tầng • 30 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-purple fw-bold"><i class="bi bi-calendar-check me-1"></i> Nhận phòng 05/11</div>
