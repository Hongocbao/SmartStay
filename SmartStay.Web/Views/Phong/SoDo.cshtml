@{
    ViewData["Title"] = "Sơ đồ Phòng theo Tầng (Room Matrix)";
}

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <!-- Chú thích màu sắc trạng thái -->
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span class="fs-8 fw-bold text-muted text-uppercase">TRẠNG THÁI:</span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-trong"><i class="bi bi-circle-fill me-1 fs-9"></i> Trống (2)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-dango"><i class="bi bi-circle-fill me-1 fs-9"></i> Đang ở (28)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-baotri"><i class="bi bi-circle-fill me-1 fs-9"></i> Bảo trì (1)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-status badge-dadat"><i class="bi bi-circle-fill me-1 fs-9"></i> Đã đặt (1)</span>
            </div>
        </div>

        <!-- Bộ lọc Tòa nhà -->
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm rounded-3 fw-semibold">
                <option value="1">Tòa nhà A - Co-Living SmartStay</option>
                <option value="2">Tòa nhà B - Boutique Apartments</option>
            </select>
            <button class="btn btn-sm btn-primary rounded-3 text-nowrap"><i class="bi bi-plus-lg me-1"></i> Thêm phòng</button>
        </div>
    </div>
</div>

<!-- Ma Trận Phòng Tầng 3 -->
<div class="card-custom mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-layers-fill text-primary me-2"></i>TẦNG 3 (8 Phòng)</h6>
        <span class="fs-8 text-muted">Lấp đầy: 7/8 (87.5%)</span>
    </div>
    <div class="row g-3">
        <!-- P.301 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#roomModal">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.301</span>
                    <span class="badge badge-status badge-dango">Đang ở</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-semibold text-truncate"><i class="bi bi-person-fill text-muted me-1"></i> Trần Văn Nam</div>
                    <div class="fs-8 text-primary fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.302 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #10B981 !important; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#roomModal">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.302</span>
                    <span class="badge badge-status badge-trong">Trống</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Sẵn sàng cho thuê</div>
                    <div class="fs-8 text-muted fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.305 (Phòng của Hồ Ngọc Bảo) -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #4F46E5 !important; cursor: pointer; background: #FAF5FF !important;" data-bs-toggle="modal" data-bs-target="#roomModal">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.305 <i class="bi bi-star-fill text-warning fs-8"></i></span>
                    <span class="badge badge-status badge-dango">Đang ở</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-bold text-slate-900 text-truncate"><i class="bi bi-person-badge-fill text-primary me-1"></i> Hồ Ngọc Bảo</div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="fs-8 text-primary fw-bold">3.500.000 đ</span>
                        <span class="badge bg-danger-subtle text-danger fs-9">Có sự cố</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- P.306 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #F59E0B !important; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#roomModal">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.306</span>
                    <span class="badge badge-status badge-baotri">Bảo trì</span>
                </div>
                <p class="text-muted fs-8 mb-2">Studio 1 giường • 22.5 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-warning fw-bold"><i class="bi bi-wrench-adjustable me-1"></i> Đang sơn nước & dọn</div>
                    <div class="fs-8 text-muted fw-bold mt-1">3.500.000 đ/tháng</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ma Trận Phòng Tầng 4 -->
<div class="card-custom mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-layers-fill text-primary me-2"></i>TẦNG 4 (8 Phòng)</h6>
        <span class="fs-8 text-muted">Lấp đầy: 8/8 (100%)</span>
    </div>
    <div class="row g-3">
        <!-- P.401 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#roomModal">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.401</span>
                    <span class="badge badge-status badge-dango">Đang ở</span>
                </div>
                <p class="text-muted fs-8 mb-2">Deluxe 2 giường tầng • 30 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 fw-semibold text-truncate"><i class="bi bi-people-fill text-muted me-1"></i> Lê Văn Cường + 1 người</div>
                    <div class="fs-8 text-primary fw-bold mt-1">5.000.000 đ/tháng</div>
                </div>
            </div>
        </div>

        <!-- P.402 -->
        <div class="col-xl-3 col-md-4 col-sm-6">
            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm" style="border-left: 5px solid #8B5CF6 !important; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#roomModal">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold fs-5 text-slate-900">P.402</span>
                    <span class="badge badge-status badge-dadat">Đã đặt</span>
                </div>
                <p class="text-muted fs-8 mb-2">Deluxe 2 giường tầng • 30 m²</p>
                <div class="pt-2 border-top">
                    <div class="fs-8 text-purple fw-bold"><i class="bi bi-calendar-check me-1"></i> Nhận phòng 01/11</div>
                    <div class="fs-8 text-muted fw-bold mt-1">Cọc: 10.000.000 đ</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết phòng -->
<div class="modal fade" id="roomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-slate-900">Chi tiết Phòng P.305 - Tòa nhà A</h5>
                    <p class="text-muted fs-8 mb-0">Loại: Studio Co-Living 1 Giường • Diện tích: 22.5 m²</p>
                </div>
                <button type="button" class="btn-close" data-bs-toggle="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light">
                            <h6 class="fw-bold fs-7 mb-2 text-primary"><i class="bi bi-person-lines-fill me-1"></i> CƯ DÂN ĐANG LƯU TRÚ</h6>
                            <p class="mb-1 fw-bold fs-6">Hồ Ngọc Bảo (MSSV: 2380600133)</p>
                            <p class="mb-1 text-muted fs-8"><i class="bi bi-telephone me-1"></i> 0901234567</p>
                            <p class="mb-1 text-muted fs-8"><i class="bi bi-calendar-event me-1"></i> Hợp đồng: 01/08/2026 - 31/07/2027</p>
                            <p class="mb-0 text-muted fs-8"><i class="bi bi-cash-stack me-1"></i> Tiền thuê: 3.500.000 đ/tháng • Cọc: 7.000.000 đ</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light">
                            <h6 class="fw-bold fs-7 mb-2 text-secondary"><i class="bi bi-box-seam-fill me-1"></i> TÀI SẢN BÀN GIAO TIÊU CHUẨN</h6>
                            <ul class="fs-8 mb-0 ps-3">
                                <li>Máy lạnh Daikin Inverter 1.5HP (Tốt)</li>
                                <li>Giường gỗ sồi & nệm cao su non êm ái</li>
                                <li>Tủ quần áo 2 cánh trượt</li>
                                <li>Bàn ghế công thái học thông minh</li>
                                <li>Khóa từ vân tay cao cấp</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer px-4 pb-4 pt-0 border-0">
                <a href="/HoaDon/Index" class="btn btn-outline-primary rounded-3 btn-sm"><i class="bi bi-receipt me-1"></i> Lập hóa đơn</a>
                <a href="/SuCo/Kanban" class="btn btn-outline-warning rounded-3 btn-sm"><i class="bi bi-tools me-1"></i> Báo sự cố</a>
                <button type="button" class="btn btn-danger rounded-3 btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Thực hiện Check-out</button>
            </div>
        </div>
    </div>
</div>
