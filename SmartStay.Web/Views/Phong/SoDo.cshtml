<!-- ================= MODAL CHI TIẾT PHÒNG TƯƠNG TÁC ================= -->
<div class="modal fade" id="roomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary text-white fs-9" id="mRoomBadgeType">Co-Living Ở Ghép</span>
                        <span class="badge bg-secondary-subtle text-secondary fs-9" id="mRoomGender">Phòng Nam</span>
                    </div>
                    <h5 class="modal-title fw-bold text-slate-900" id="mRoomTitle">Chi tiết Phòng P.305 - Tòa nhà A</h5>
                    <p class="text-muted fs-8 mb-0" id="mRoomSub">Loại: Co-Living 3 giường • Diện tích: 22.5 m²</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <h6 class="fw-bold fs-7 mb-2 text-primary"><i class="bi bi-people-fill me-1"></i> DANH SÁCH GIƯỜNG & BẠN CÙNG PHÒNG</h6>
                            <div id="mBedListContainer" class="mb-3">
                                <!-- Rendered dynamically -->
                            </div>
                            <div class="pt-2 border-top fs-8">
                                <p class="mb-1 text-muted"><i class="bi bi-calendar-event me-1"></i> Kỳ hợp đồng hiện tại: <strong>01/08/2026 - 31/07/2027</strong></p>
                                <p class="mb-0 text-muted"><i class="bi bi-cash-stack me-1"></i> Giá thuê trọn phòng: <strong class="text-danger" id="mRentPrice">3.500.000 đ</strong>/tháng</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <h6 class="fw-bold fs-7 mb-2 text-success"><i class="bi bi-lock-fill me-1"></i> KHÓA THÔNG MINH IOT & RA VÀO</h6>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge bg-success text-white"><i class="bi bi-wifi"></i> Online</span>
                                <span class="fs-8 text-muted">Pin: <strong class="text-dark" id="mLockBattery">92%</strong></span>
                                <span class="badge bg-light text-dark border">RFID + Mã PIN Cá Nhân</span>
                            </div>
                            <div class="fs-8 text-muted mb-3">Mã khóa: <strong>LOCK-A-305</strong> • Mật mã master: <code>305888</code></div>
                            
                            <button class="btn btn-sm btn-outline-success w-100 rounded-3 mb-2" onclick="unlockDoorRemote()">
                                <i class="bi bi-unlock-fill me-1"></i> Gửi Lệnh Mở Khóa Từ Xa (Remote Unlock)
                            </button>

                            <!-- Khu vực duyệt bạn cùng phòng mới (Roommate Consent) -->
                            <div id="mMatchingBox" class="mt-3 p-3 rounded-3 bg-white border border-warning shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-warning text-dark fs-9"><i class="bi bi-person-plus-fill me-1"></i> ĐƠN XIN VÀO Ở GHÉP MỚI</span>
                                    <span class="fs-9 text-muted">Chờ duyệt</span>
                                </div>
                                <div class="fw-bold fs-8 text-slate-900 mt-1">Trần Hoàng Gia Bảo (MSSV: 2380600178)</div>
                                <div class="fs-9 text-muted">Xin vào Giường C • ĐH Văn Lang • 🚭 Không hút thuốc • 🌙 Ngủ trước 23h</div>
                                <div class="p-2 rounded bg-light border mt-2 fs-9">
                                    <span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> Hồ Ngọc Bảo & Nguyễn Dương Bảo</span> đã biểu quyết: <strong class="text-success">ĐỒNG Ý (100%)</strong>
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn btn-xs btn-success flex-fill rounded-2" onclick="approveRoommate()">
                                        <i class="bi bi-check-lg"></i> Duyệt Ký Hợp Đồng Giường C
                                    </button>
                                    <button class="btn btn-xs btn-outline-secondary rounded-2" onclick="rejectRoommate()">
                                        <i class="bi bi-x-lg"></i> Từ chối
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer px-4 pb-4 pt-0 border-0 d-flex flex-wrap gap-2 justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-primary rounded-3 btn-sm" onclick="promptElectricWater()">
                        <i class="bi bi-speedometer2 me-1"></i> Ghi chỉ số điện nước
                    </button>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/HoaDon/Index" class="btn btn-outline-secondary rounded-3 btn-sm"><i class="bi bi-receipt me-1"></i> Lập hóa đơn</a>
                    <a href="/SuCo/Kanban" class="btn btn-outline-warning rounded-3 btn-sm"><i class="bi bi-tools me-1"></i> Báo sự cố</a>
                    <button type="button" class="btn btn-danger rounded-3 btn-sm shadow-sm" onclick="performCheckout()">
                        <i class="bi bi-box-arrow-right me-1"></i> Thực hiện Check-out
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL THÊM PHÒNG MỚI (CHUẨN CO-LIVING & Ở GHÉP) ================= -->
<div class="modal fade" id="modalAddRoom" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-slate-900">Thêm Căn Hộ / Phòng Mới</h5>
                    <p class="text-muted fs-8 mb-0">Hỗ trợ mô hình Thuê Nguyên Căn hoặc Ở Ghép Co-Living linh hoạt</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addRoomForm" onsubmit="handleAddRoom(event)">
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label fw-semibold fs-7">Mã số phòng</label>
                            <input type="text" id="arCode" class="form-control rounded-3" placeholder="Ví dụ: P.308" required>
                        </div>
                        <div class="col-5">
                            <label class="form-label fw-semibold fs-7">Tầng</label>
                            <select id="arFloor" class="form-select rounded-3">
                                <option value="3">Tầng 3</option>
                                <option value="4">Tầng 4</option>
                                <option value="5">Tầng 5</option>
                            </select>
                        </div>
                    </div>

                    <!-- Hình thức cho thuê -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold fs-7">Hình thức cho thuê *</label>
                        <select id="arRentalModel" class="form-select rounded-3" onchange="toggleCapacityOptions(this.value)">
                            <option value="coliving" selected>👥 Ở Ghép Co-Living (Cho thuê lẻ từng giường/slot)</option>
                            <option value="private">🏠 Thuê Nguyên Căn (Trọn gói cả phòng/căn hộ)</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Sức chứa (Số giường)</label>
                            <select id="arCapacity" class="form-select rounded-3">
                                <option value="1">1 Giường (Phòng đơn)</option>
                                <option value="2">2 Giường (Studio 2 bạn)</option>
                                <option value="3" selected>3 Giường (Co-Living 3 người)</option>
                                <option value="4">4 Giường (Ký túc xá tầng)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Quy định Giới tính</label>
                            <select id="arGender" class="form-select rounded-3">
                                <option value="Nam">🚹 Phòng Nam</option>
                                <option value="Nữ">🚺 Phòng Nữ</option>
                                <option value="Tự do">🚻 Nam/Nữ Tự do</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Diện tích (m²)</label>
                            <input type="number" id="arArea" class="form-control rounded-3" value="25" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold fs-7">Giá thuê phòng/tháng</label>
                            <input type="text" id="arPrice" class="form-control rounded-3" value="3.500.000 đ" required>
                        </div>
                    </div>

                    <!-- Quy tắc bảo vệ văn hóa phòng -->
                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="arConsentRequired" checked>
                            <label class="form-check-label fw-bold fs-8 text-slate-800" for="arConsentRequired">
                                Biểu quyết đồng thuận khi có người mới xin ghép phòng
                            </label>
                        </div>
                        <div class="fs-9 text-muted">
                            <i class="bi bi-info-circle me-1"></i> Khi có người mới muốn thuê giường trống, cư dân hiện tại trong phòng phải bấm <strong>[Đồng ý]</strong> thì Admin mới duyệt hợp đồng (Đảm bảo hợp tính cách, giờ giấc).
                        </div>
                    </div>

                    <div class="modal-footer px-0 pb-0 pt-2 border-0">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                            <i class="bi bi-plus-circle me-1"></i> Lưu Phòng Mới
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    let currentSelectedRoom = 'P.305';

    function toggleCapacityOptions(val) {
        const cap = document.getElementById('arCapacity');
        if (val === 'private') {
            cap.value = '1';
        } else {
            cap.value = '3';
        }
    }

    function openRoomModal(roomCode, residentName, phone, price, status, sub, battery, badgeText, genderText, bedList, hasPendingMatching) {
        currentSelectedRoom = roomCode;
        document.getElementById('mRoomTitle').innerText = `Chi tiết Phòng ${roomCode} - Tòa nhà A`;
        document.getElementById('mRoomSub').innerText = sub;
        document.getElementById('mRentPrice').innerText = price;
        document.getElementById('mLockBattery').innerText = battery;
        document.getElementById('mRoomBadgeType').innerText = badgeText || status;
        document.getElementById('mRoomGender').innerText = genderText || 'Tự do';

        const bedContainer = document.getElementById('mBedListContainer');
        bedContainer.innerHTML = '';

        if (!bedList || bedList.length === 0) {
            bedContainer.innerHTML = '<div class="text-muted fs-8 py-2">Chưa có thông tin danh sách giường cho phòng này.</div>';
        } else {
            bedList.forEach(b => {
                const isOccupied = b.status === 'Đang ở';
                const html = `
                    <div class="d-flex justify-content-between align-items-center p-2 rounded-2 mb-2 ${isOccupied ? 'bg-white border' : 'bg-success-subtle border border-success'}">
                        <div>
                            <div class="fw-bold fs-8 ${isOccupied ? 'text-slate-900' : 'text-success'}">
                                <i class="bi ${isOccupied ? 'bi-person-check-fill text-primary' : 'bi-plus-circle-fill text-success'} me-1"></i> ${b.bed}: ${b.name}
                            </div>
                            <div class="fs-9 text-muted">${b.phone ? ('SĐT: ' + b.phone) : 'Chỗ trống sẵn sàng đón bạn mới'}</div>
                        </div>
                        <span class="badge ${isOccupied ? 'bg-primary-subtle text-primary' : 'bg-success text-white'} fs-9">
                            ${b.status}
                        </span>
                    </div>
                `;
                bedContainer.insertAdjacentHTML('beforeend', html);
            });
        }

        const matchBox = document.getElementById('mMatchingBox');
        if (hasPendingMatching) {
            matchBox.classList.remove('d-none');
        } else {
            matchBox.classList.add('d-none');
        }

        new bootstrap.Modal(document.getElementById('roomModal')).show();
    }

    function approveRoommate() {
        alert('Ban Quản Lý & Cư dân P.305 đã phê duyệt ứng viên Trần Hoàng Gia Bảo vào Giường C thành công! Hợp đồng đã kích hoạt và hệ thống tự động thêm bạn vào nhóm Chia tiền phòng.');
        document.getElementById('mMatchingBox').innerHTML = '<div class="alert alert-success fs-8 mb-0 py-2"><i class="bi bi-check-circle me-1"></i> Giường C đã lấp đầy! Phòng P.305 đã đạt 3/3 thành viên (100%).</div>';
        document.getElementById('badge-p305').className = 'badge bg-success text-white px-2 py-1 fs-9 rounded-pill';
        document.getElementById('badge-p305').innerText = 'Ở ghép 3/3 (Đầy)';
    }

    function rejectRoommate() {
        if (confirm('Bạn có chắc muốn từ chối yêu cầu ghép phòng này để tìm người có phong cách sống phù hợp hơn?')) {
            document.getElementById('mMatchingBox').remove();
            showRoomAlert('Đã từ chối đơn ghép phòng. Giường C vẫn đang mở đón bạn mới.');
        }
    }

    function unlockDoorRemote() {
        showRoomAlert(`Đã phát lệnh mở khóa qua WiFi IoT tới phòng ${currentSelectedRoom}! Cửa đã được mở.`);
    }

    function filterBuilding(val) {
        document.querySelectorAll('.room-building-sec').forEach(sec => {
            if (val === 'all' || sec.getAttribute('data-building') === val) {
                sec.classList.remove('d-none');
            } else {
                sec.classList.add('d-none');
            }
        });
    }

    function applyRoomStatusToDom(roomCode, status) {
        const slug = roomCode.replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
        const card = document.getElementById('card-' + slug);
        const badge = document.getElementById('badge-' + slug);
        if (!card || !badge) return false;

        const inner = card.querySelector('.room-inner-card') || card.querySelector('.card');
        const st = (status || '').toLowerCase();
        if (st.includes('trống')) {
            if (inner) {
                inner.style.background = '#FFFFFF';
                inner.style.setProperty('border-left', '5px solid #10B981', 'important');
            }
            badge.className = 'badge badge-status badge-trong';
            badge.innerText = 'Trống';
        } else if (st.includes('bảo trì')) {
            if (inner) {
                inner.style.background = '#FFFFFF';
                inner.style.setProperty('border-left', '5px solid #F59E0B', 'important');
            }
            badge.className = 'badge badge-status badge-baotri';
            badge.innerText = 'Bảo trì';
        } else if (st.includes('đặt')) {
            if (inner) {
                inner.style.background = '#FFFFFF';
                inner.style.setProperty('border-left', '5px solid #8B5CF6', 'important');
            }
            badge.className = 'badge badge-status badge-dadat';
            badge.innerText = 'Đã đặt';
        } else {
            if (inner) {
                inner.style.background = '#FFFFFF';
                inner.style.setProperty('border-left', '5px solid #4F46E5', 'important');
            }
            badge.className = 'badge badge-status badge-dango';
            badge.innerText = 'Đang ở';
        }
        return true;
    }

    function promptElectricWater() {
        const dien = prompt(`Nhập chỉ số điện mới cho phòng ${currentSelectedRoom} (kWh):`, "1540");
        if (dien) {
            const nuoc = prompt(`Nhập chỉ số nước mới cho phòng ${currentSelectedRoom} (m³):`, "92");
            if (nuoc) {
                fetch('/api/sync/chi-so-cu-dan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ KyHieuPhong: currentSelectedRoom, CheDo: 'both', DienMoiChup: parseFloat(dien) || 0, NuocMoiChup: parseFloat(nuoc) || 0, NguonCapNhat: 'Ban Quản Lý' })
                }).catch(() => {});
                showRoomAlert(`Đã ghi nhận chỉ số phòng ${currentSelectedRoom}: Điện ${dien} kWh, Nước ${nuoc} m³. Hệ thống đã cập nhật vào kỳ tính phí & đồng bộ App!`);
            }
        }
    }

    function performCheckout() {
        if (confirm(`Bạn có chắc chắn muốn làm thủ tục Check-out trả phòng cho phòng ${currentSelectedRoom}? Hệ thống sẽ xuất biên bản bàn giao tài sản và chuyển trạng thái phòng sang [Trống].`)) {
            const modal = bootstrap.Modal.getInstance(document.getElementById('roomModal'));
            if (modal) modal.hide();

            applyRoomStatusToDom(currentSelectedRoom, 'Trống');
            const curOcc = Math.max(0, parseInt(document.getElementById('countDangO').innerText) - 1);
            const curEmpty = parseInt(document.getElementById('countTrong').innerText) + 1;
            document.getElementById('countDangO').innerText = curOcc.toString();
            document.getElementById('countTrong').innerText = curEmpty.toString();

            fetch('/api/sync/cap-nhat-phong', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ KyHieuPhong: currentSelectedRoom, TrangThai: 'Trống' })
            }).catch(() => {});
            showRoomAlert(`Thực hiện Check-out thành công cho phòng ${currentSelectedRoom}! Đã đồng bộ Realtime trạng thái [Trống] sang Android & Web App.`);
        }
    }

    function handleAddRoom(e) {
        e.preventDefault();
        const code = document.getElementById('arCode').value.trim();
        const model = document.getElementById('arRentalModel').value;
        const capacity = document.getElementById('arCapacity').value;
        const gender = document.getElementById('arGender').value;
        const area = document.getElementById('arArea').value;
        const price = document.getElementById('arPrice').value;

        const isColiving = model === 'coliving';
        const badgeClass = isColiving ? 'bg-purple text-white' : 'badge-status badge-trong';
        const badgeStyle = isColiving ? 'background:#7C3AED;' : '';
        const badgeLabel = isColiving ? `Ở ghép (0/${capacity} Giường - Còn trống)` : 'Trống (0/1)';
        const borderCol = isColiving ? '#7C3AED' : '#10B981';

        const beds = [];
        for (let i = 1; i <= parseInt(capacity); i++) {
            beds.push({ bed: `Giường ${i}`, name: 'Chưa có người', phone: '', status: 'Trống' });
        }

        const slug = code.replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
        const newCard = `
            <div class="col-xl-3 col-md-4 col-sm-6" id="card-${slug}" data-room="${code}">
                <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid ${borderCol} !important; cursor: pointer;" onclick='openRoomModal("${code}", "", "", "${price}", "Trống", "${isColiving ? "Co-Living Ở Ghép" : "Studio"} • ${area} m²", "95%", "${badgeLabel}", "${gender}", ${JSON.stringify(beds)}, false)'>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold fs-5 text-slate-900">${code}</span>
                        <span class="badge ${badgeClass} fs-9" id="badge-${slug}" style="${badgeStyle}">${badgeLabel}</span>
                    </div>
                    <div class="d-flex align-items-center gap-1 mb-2">
                        <span class="badge bg-light text-muted border fs-9">${area} m²</span>
                        <span class="badge bg-light text-primary border fs-9">${gender}</span>
                        <span class="badge bg-light text-success border fs-9"><i class="bi bi-check2"></i> Mới thêm</span>
                    </div>
                    <div class="pt-2 border-top">
                        <div class="fs-8 text-success fw-bold"><i class="bi bi-door-open me-1"></i> ${isColiving ? `Cho thuê lẻ ${capacity} giường` : 'Cho thuê nguyên căn'}</div>
                        <div class="fs-8 text-muted fw-bold mt-1">${price}/tháng</div>
                    </div>
                </div>
            </div>
        `;

        document.getElementById('tang3Rooms').insertAdjacentHTML('beforeend', newCard);
        bootstrap.Modal.getInstance(document.getElementById('modalAddRoom')).hide();
        document.getElementById('countTrong').innerText = (parseInt(document.getElementById('countTrong').innerText) + 1).toString();

        const numericPrice = parseFloat(String(price).replace(/[^0-9]/g, '')) || 3500000;
        fetch('/api/sync/cap-nhat-phong', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ KyHieuPhong: code, TrangThai: 'Trống', GiaThue: numericPrice })
        }).catch(() => {});

        showRoomAlert(`Đã thêm thành công căn hộ mới ${code} (${isColiving ? 'Mô hình Ở Ghép Co-Living' : 'Mô hình Thuê Nguyên Căn'}) & đồng bộ Realtime sang App!`);
    }

    document.addEventListener('DOMContentLoaded', async function () {
        try {
            const res = await fetch('/api/sync/snapshot');
            if (!res.ok) return;
            const data = await res.json();
            const rooms = data.phongs || data.rooms || [];
            if (!Array.isArray(rooms)) return;

            rooms.forEach(r => {
                if (!r.kyHieuPhong) return;
                const applied = applyRoomStatusToDom(r.kyHieuPhong, r.trangThai);
                if (!applied) {
                    const priceTxt = ((r.giaThue || 3500000)).toLocaleString('vi-VN') + ' đ';
                    const slug = r.kyHieuPhong.replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
                    const html = `
                        <div class="col-xl-3 col-md-4 col-sm-6" id="card-${slug}" data-room="${r.kyHieuPhong}">
                            <div class="card border rounded-4 p-3 bg-white h-100 shadow-sm room-inner-card" style="border-left: 5px solid #4F46E5 !important; cursor: pointer;" onclick="openRoomModal('${r.kyHieuPhong}', 'Đồng bộ App', '', '${priceTxt}', '${r.trangThai}', 'Tầng ${r.soTang || 3} • ${r.dienTich || 24} m²', '95%')">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold fs-5 text-slate-900">${r.kyHieuPhong}</span>
                                    <span class="badge badge-status badge-dango" id="badge-${slug}">${r.trangThai || 'Đang ở'}</span>
                                </div>
                                <p class="text-muted fs-8 mb-2">Đồng bộ từ App • ${r.dienTich || 24} m²</p>
                                <div class="pt-2 border-top">
                                    <div class="fs-8 text-primary fw-bold">${priceTxt}/tháng</div>
                                </div>
                            </div>
                        </div>`;
                    document.getElementById('tang3Rooms').insertAdjacentHTML('beforeend', html);
                    applyRoomStatusToDom(r.kyHieuPhong, r.trangThai);
                }
            });
        } catch (e) { }
    });

    function showRoomAlert(msg) {
        const alertBox = document.getElementById('roomAlert');
        document.getElementById('roomAlertText').innerText = msg;
        alertBox.classList.remove('d-none');
        alertBox.classList.add('show');
        setTimeout(() => {
            alertBox.classList.remove('show');
            alertBox.classList.add('d-none');
        }, 5000);
    }
</script>
