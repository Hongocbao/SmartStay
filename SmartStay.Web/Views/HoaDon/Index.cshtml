@{
    ViewData["Title"] = "Quản lý Hóa đơn & Đối soát VietQR - SmartStay";
}

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-calendar3 me-2 text-primary"></i>KỲ HÓA ĐƠN: THÁNG 10/2026</h6>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill" id="badgeTotalInvoices">Đã phát hành: 28/28</span>
            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill" id="badgePaidInvoices">Đã thu: 24/28</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <!-- Nút Nhập Excel số lượng lớn -->
            <button class="btn btn-sm btn-success rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalImportExcel">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Nhập Chỉ Số Điện Nước (Excel)
            </button>
            <button class="btn btn-sm btn-outline-success rounded-3" onclick="exportToExcel()">
                <i class="bi bi-download me-1"></i> Xuất Báo Cáo Excel
            </button>
            <button class="btn btn-sm btn-outline-primary rounded-3" onclick="calculateTieredBilling()">
                <i class="bi bi-calculator me-1"></i> Tính bậc thang tự động
            </button>
            <button class="btn btn-sm btn-primary rounded-3" onclick="publishBatchVietQR()">
                <i class="bi bi-qr-code me-1"></i> Phát hành VietQR hàng loạt
            </button>
        </div>
    </div>
</div>

<!-- Alert thông báo tương tác -->
<div id="actionAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="alertContent">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('actionAlert').classList.add('d-none')"></button>
</div>

