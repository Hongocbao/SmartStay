<script>
    // 1. Duyệt biên lai chuyển khoản phòng P.305
    function approveReceipt(roomCode, residentName, amount) {
        document.getElementById('status-305').innerHTML = '<span class="badge bg-success text-white status-badge"><i class="bi bi-check-circle me-1"></i>Đã thanh toán</span>';
        document.getElementById('action-305').innerHTML = '<span class="text-success fs-8 fw-semibold"><i class="bi bi-patch-check-fill text-success"></i> Đã khớp VietQR</span>';
        document.getElementById('row-305').classList.remove('table-primary-subtle');
        document.getElementById('badgePaidInvoices').innerText = 'Đã thu: 25/28';
        
        showAlert(`Đã duyệt xác nhận biên lai ${amount} của phòng ${roomCode} (${residentName}) thành công! Hóa đơn đã cập nhật trạng thái [Đã thanh toán] trên toàn hệ thống.`);
    }

    // 2. Tính bậc thang tự động
    function calculateTieredBilling() {
        showAlert('Đang tự động đồng bộ chỉ số công tơ điện nước và tính giá bậc thang theo Quyết định Bộ Công Thương 2026. Tất cả 28 hóa đơn đã được cập nhật số liệu chính xác!');
    }

    // 3. Phát hành VietQR hàng loạt
    function publishBatchVietQR() {
        showAlert('Đã phát hành thành công 28 mã VietQR NAPAS 247 động gắn kèm thông tin số tài khoản và nội dung cú pháp thanh toán!');
    }

    // 4. Lọc trạng thái
    function filterTable(status) {
        const rows = document.querySelectorAll('#invoiceTbody tr');
        rows.forEach(r => {
            if (status === 'all') {
                r.style.display = '';
            } else {
                const text = r.innerText;
                r.style.display = text.includes(status) ? '' : 'none';
            }
        });
    }

    // 5. Tính toán dòng Excel
    function recalcRow(id) {
        const dienCu = parseFloat(document.getElementById('dienCu-' + id).value) || 0;
        const dienMoi = parseFloat(document.getElementById('dienMoi-' + id).value) || 0;
        const nuocCu = parseFloat(document.getElementById('nuocCu-' + id).value) || 0;
        const nuocMoi = parseFloat(document.getElementById('nuocMoi-' + id).value) || 0;

        const dienTieuThu = Math.max(0, dienMoi - dienCu);
        const nuocTieuThu = Math.max(0, nuocMoi - nuocCu);

        document.getElementById('dienTieuThu-' + id).innerText = dienTieuThu;
        document.getElementById('nuocTieuThu-' + id).innerText = nuocTieuThu;

        // Công thức tính bậc thang sơ bộ
        let tienDien = 0;
        if (dienTieuThu <= 50) tienDien = dienTieuThu * 1806;
        else if (dienTieuThu <= 100) tienDien = 50 * 1806 + (dienTieuThu - 50) * 1866;
        else tienDien = 50 * 1806 + 50 * 1866 + (dienTieuThu - 100) * 2167;

        let tienNuoc = nuocTieuThu <= 10 ? nuocTieuThu * 12000 : 10 * 12000 + (nuocTieuThu - 10) * 15000;
        let tongTien = Math.round(tienDien + tienNuoc);

        document.getElementById('thanhTien-' + id).innerText = tongTien.toLocaleString('vi-VN') + ' đ';
    }

    // 6. Áp dụng bảng tính Excel vào danh sách
    function applyExcelBatch() {
        const modal = bootstrap.Modal.getInstance(document.getElementById('modalImportExcel'));
        if (modal) modal.hide();
        showAlert('Đã nhập và áp dụng thành công bảng chỉ số điện nước từ Excel cho toàn bộ phòng! Các hóa đơn đã được tính toán lại theo biểu giá lũy tiến mới.');
    }

    // 7. Xử lý tải file Excel lên
    function handleExcelUpload(input) {
        if (input.files && input.files[0]) {
            const fileName = input.files[0].name;
            showAlert(`Đã đọc thành công dữ liệu từ file Excel: "${fileName}". Các chỉ số điện nước đã được điền tự động vào bảng tính!`);
        }
    }

    // 8. Tải file Excel mẫu
