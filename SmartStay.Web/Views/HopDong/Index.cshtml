<script>
    function viewPdfContract(code, name, room, price, start, end) {
        document.getElementById('pdfContractCode').innerText = code;
        document.getElementById('pdfContractNum').innerText = code;
        document.getElementById('pdfResidentName').innerText = name;
        document.getElementById('pdfRoomCode').innerText = room;
        document.getElementById('pdfRentPrice').innerText = price;
        document.getElementById('pdfDuration').innerText = `${start} đến ${end}`;
        
        new bootstrap.Modal(document.getElementById('modalViewPdf')).show();
    }

    function filterContracts() {
        const q = (document.getElementById('contractSearch')?.value || '').trim().toLowerCase();
        const st = document.getElementById('contractStatusFilter')?.value || 'all';
        document.querySelectorAll('#contractTbody tr').forEach(tr => {
            const text = tr.innerText.toLowerCase();
            const matchQ = !q || text.includes(q);
            const matchSt = st === 'all' || tr.innerText.includes(st);
            tr.style.display = (matchQ && matchSt) ? '' : 'none';
        });
    }

    function renewContract(code, name, room) {
        document.getElementById('status-302').innerHTML = '<span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>Đã gia hạn (Đến 2027)</span>';
        document.getElementById('action-302').innerHTML = '<span class="text-success fs-8 fw-semibold"><i class="bi bi-shield-check"></i> Hiệu lực 12 tháng</span>';
        filterContracts();
        showContractAlert(`Đã gia hạn hợp đồng ${code} cho cư dân ${name} (${room}) thêm 12 tháng thành công!`);
    }

