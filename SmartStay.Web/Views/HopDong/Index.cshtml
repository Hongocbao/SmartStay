@{
    ViewData["Title"] = "Quản lý Cư dân & Hợp đồng lưu trú - SmartStay";
}

<div class="card-custom mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <h6 class="fw-bold mb-0 text-slate-800"><i class="bi bi-person-lines-fill me-2 text-primary"></i>HỢP ĐỒNG LƯU TRÚ</h6>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill" id="badgeTotalContracts">Đang hiệu lực: 28</span>
            <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill">Sắp hết hạn: 1</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <!-- Nút Nhập danh sách cư dân số lượng lớn bằng Excel -->
            <button class="btn btn-sm btn-success rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalImportResidentExcel">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Nhập Cư Dân Hàng Loạt (Excel)
            </button>
            <button class="btn btn-sm btn-outline-success rounded-3" onclick="exportContractExcel()">
                <i class="bi bi-download me-1"></i> Xuất Excel Hợp Đồng
            </button>
            <button class="btn btn-sm btn-primary rounded-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNewContract">
                <i class="bi bi-file-earmark-plus me-1"></i> Lập hợp đồng mới
            </button>
        </div>
    </div>
</div>

<!-- Alert thông báo -->
<div id="contractAlert" class="alert alert-success alert-dismissible fade d-none rounded-3 shadow-sm" role="alert">
    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
    <span id="contractAlertText">Thông báo</span>
    <button type="button" class="btn-close" onclick="document.getElementById('contractAlert').classList.add('d-none')"></button>
</div>

<div class="card-custom">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <div class="input-group input-group-sm" style="max-width: 340px;">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" id="contractSearch" class="form-control border-start-0" placeholder="Tìm mã HĐ, phòng (P.305), tên cư dân..." oninput="filterContracts()">
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="fs-8 fw-bold text-muted">TRẠNG THÁI:</span>
            <select id="contractStatusFilter" class="form-select form-select-sm rounded-3" style="width: auto;" onchange="filterContracts()">
                <option value="all">Tất cả trạng thái</option>
                <option value="Đang hiệu lực">Đang hiệu lực</option>
                <option value="Sắp hết hạn">Sắp hết hạn</option>
                <option value="Đã gia hạn">Đã gia hạn</option>
