<!-- ================= MODAL LẬP HỢP ĐỒNG MỚI ================= -->
<div class="modal fade" id="modalNewContract" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-slate-900">Lập Hợp Đồng Lưu Trú Mới</h5>
                    <p class="text-muted fs-8 mb-0">Tạo hồ sơ cư trú và kích hoạt tài khoản cư dân vào phòng</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="newContractForm" onsubmit="handleCreateContract(event)">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Họ và tên cư dân đại diện</label>
                            <input type="text" id="ncName" class="form-control rounded-3" placeholder="Ví dụ: Hoàng Minh Đức" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Số điện thoại liên hệ</label>
                            <input type="text" id="ncPhone" class="form-control rounded-3" placeholder="0909888999" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Số CCCD / CMND</label>
                            <input type="text" id="ncCccd" class="form-control rounded-3" placeholder="07920300xxxx" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Chọn phòng cho thuê</label>
                            <select id="ncRoom" class="form-select rounded-3">
                                <option value="P.102">P.102 (Phòng Standard - Tầng 1)</option>
                                <option value="P.202">P.202 (Studio Ban Công - Tầng 2)</option>
                                <option value="P.302">P.302 (Studio Ban Công - Tầng 3)</option>
                                <option value="P.402">P.402 (Duplex 2 Giường - Tầng 4)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Ngày bắt đầu thuê</label>
                            <input type="date" id="ncStartDate" class="form-control rounded-3" value="2026-11-01" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Thời hạn hợp đồng</label>
                            <select id="ncDuration" class="form-select rounded-3">
                                <option value="6 tháng">6 tháng</option>
                                <option value="12 tháng" selected>12 tháng (1 năm)</option>
                                <option value="24 tháng">24 tháng (2 năm)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Giá thuê hàng tháng (VNĐ)</label>
                            <input type="text" id="ncRentPrice" class="form-control rounded-3" value="3.500.000 đ" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold fs-7">Tiền cọc đảm bảo (VNĐ)</label>
                            <input type="text" id="ncDeposit" class="form-control rounded-3" value="7.000.000 đ" required>
                        </div>
                    </div>
                    <div class="modal-footer px-0 pb-0 pt-4 border-0 d-flex flex-wrap gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Tạo Hợp Đồng & Ký Điện Tử
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

