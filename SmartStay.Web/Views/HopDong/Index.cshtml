    function downloadResidentTemplate() {
        const csvContent = "data:text/csv;charset=utf-8,\uFEFF"
            + "STT,HoTen,SoDienThoai,SoCCCD,MaPhong,NgayVaoO,GiaThue,TienCoc\n"
            + "1,Nguyen Van Hung,0987112233,079203001234,P.102,2026-11-01,3500000,7000000\n"
            + "2,Tran Thi Mai,0977223344,079203005678,P.202,2026-11-01,3800000,7600000\n";
        
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "Template_CuDan_HopDong_SmartStay.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function exportContractExcel() {
        const csvContent = "data:text/csv;charset=utf-8,\uFEFF"
            + "MaHopDong,Phong,CuDanDaiDien,SoDienThoai,ThoiHanThue,GiaThue,TienCoc,TrangThai\n"
            + "HD-2026-0305,P.305,Ho Ngoc Bao,0901234567,12 thang,3500000,7000000,Dang hieu luc\n"
            + "HD-2026-0301,P.301,Tran Van Nam,0912345678,12 thang,3500000,7000000,Dang hieu luc\n"
            + "HD-2026-0201,P.201,Nguyen Duong Bao,0902234567,12 thang,3800000,7600000,Dang hieu luc\n"
            + "HD-2026-0401,P.401,Tran Hoang Gia Bao,0903234567,12 thang,5000000,10000000,Dang hieu luc\n";

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "DanhSach_HopDong_SmartStay_2026.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        showContractAlert('Đã xuất toàn bộ danh sách hợp đồng lưu trú ra file Excel (.CSV) thành công!');
    }

    function showContractAlert(msg) {
        const alertBox = document.getElementById('contractAlert');
        document.getElementById('contractAlertText').innerText = msg;
        alertBox.classList.remove('d-none');
        alertBox.classList.add('show');
        setTimeout(() => {
            alertBox.classList.remove('show');
            alertBox.classList.add('d-none');
        }, 5000);
    }
</script>
