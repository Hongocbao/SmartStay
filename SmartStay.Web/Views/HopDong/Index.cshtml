        const deposit = document.getElementById('ncDeposit').value;
        const duration = document.getElementById('ncDuration').value;

        const newRow = `
            <tr class="table-success-subtle">
                <td class="fw-bold">HD-2026-0${room.replace('P.', '')}</td>
                <td><span class="badge bg-success text-white">${room}</span></td>
                <td class="fw-bold">${name}</td>
                <td>${phone}</td>
                <td>01/11/2026 - 31/10/2027 (${duration})</td>
