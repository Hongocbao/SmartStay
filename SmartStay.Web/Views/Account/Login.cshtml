@model SmartStay.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng Nhập Hệ Thống Phân Quyền - SmartStay";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary: #4F46E5;
            --primary-hover: #4338CA;
            --dark-bg: #0B0F19;
            --card-bg: #151D2F;
            --card-border: rgba(255, 255, 255, 0.08);
            --text-main: #F8FAFC;
            --text-muted: #94A3B8;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--dark-bg);
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.18) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.15) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
            color: var(--text-main);
            margin: 0;
        }

        .login-wrapper {
            width: 100%;
            max-width: 480px;
        }

        .login-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 36px 32px;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), 0 0 50px -20px rgba(99, 102, 241, 0.25);
            backdrop-filter: blur(16px);
        }

        .brand-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .brand-logo-icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #6366F1, #3B82F6);
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            color: #fff;
            margin-bottom: 14px;
            box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
        }

        .brand-title {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }

        .brand-sub {
            color: var(--text-muted);
            font-size: 13px;
        }

        /* Role selector buttons */
        .role-selector-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #818CF8;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .role-btn-group {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 24px;
        }

        .role-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 10px 6px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 600;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
        }

        .role-btn i {
            font-size: 18px;
        }

        .role-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.16);
        }

        .role-btn.active {
            background: rgba(99, 102, 241, 0.18);
            border-color: #6366F1;
            color: #fff;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
        }

        .role-badge-admin.active { border-color: #8B5CF6; background: rgba(139, 92, 246, 0.2); }
        .role-badge-tech.active { border-color: #10B981; background: rgba(16, 185, 129, 0.2); }
        .role-badge-resident.active { border-color: #3B82F6; background: rgba(59, 130, 246, 0.2); }

        .role-desc-box {
            background: rgba(255, 255, 255, 0.03);
            border-left: 3px solid #6366F1;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        /* Form Controls */
        .form-label {
            font-size: 12.5px;
            font-weight: 600;
            color: #CBD5E1;
            margin-bottom: 6px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 18px;
        }

        .input-group-custom i.prefix-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748B;
            font-size: 16px;
            z-index: 5;
        }

        .form-control-custom {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #fff !important;
            border-radius: 12px;
            padding: 12px 14px 12px 42px;
            font-size: 14px;
            width: 100%;
            transition: all 0.2s ease;
        }

        .form-control-custom:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #475569;
        }

        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748B;
            cursor: pointer;
            z-index: 5;
            background: none;
            border: none;
            padding: 0;
        }

        .btn-login {
            background: linear-gradient(135deg, #4F46E5, #3B82F6);
            border: none;
            color: #fff;
            font-weight: 700;
            font-size: 14.5px;
            padding: 13px;
            border-radius: 12px;
            width: 100%;
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
            transition: all 0.2s ease;
            margin-top: 6px;
        }

        .btn-login:hover {
            opacity: 0.95;
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.5);
            color: #fff;
        }

        .footer-tag {
            text-align: center;
            margin-top: 24px;
            font-size: 11.5px;
            color: #64748B;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <!-- Brand -->
            <div class="brand-header">
                <div class="brand-logo-icon">
                    <i class="bi bi-buildings-fill"></i>
                </div>
                <h1 class="brand-title">SmartStay Web Portal</h1>
                <p class="brand-sub">Hệ Thống Quản Trị & Vận Hành Lưu Trú Thông Minh</p>
            </div>

            <!-- Role Quick Selector -->
            <div class="role-selector-title">
                <i class="bi bi-person-badge-fill"></i> Chọn Không Gian Làm Việc (Phân Quyền)
            </div>

            <div class="role-btn-group">
                <div class="role-btn role-badge-admin active" onclick="selectRole('Admin', 'admin', '123456', 'Toàn quyền Ban Quản Lý: Dashboard KPI, sơ đồ phòng, đối soát VietQR, hợp đồng cư dân.')">
                    <i class="bi bi-shield-lock-fill text-purple"></i>
                    <span>Ban Quản Lý</span>
                </div>
                <div class="role-btn role-badge-tech" onclick="selectRole('KyThuat', 'tech', '123456', 'Kỹ Thuật Viên: Tiếp nhận phiếu sửa chữa Kanban, báo cáo vật tư thay thế, bảo trì IoT.')">
                    <i class="bi bi-tools text-success"></i>
                    <span>Kỹ Thuật</span>
                </div>
                <div class="role-btn role-badge-resident" onclick="selectRole('CuDan', '2380600133', '123456', 'Cổng Cư Dân: Tra cứu tiền điện nước bậc thang, mã VietQR, báo sự cố phòng P.305.')">
                    <i class="bi bi-person-workspace text-primary"></i>
                    <span>Cư Dân</span>
                </div>
            </div>

            <!-- Description Box for Chosen Role -->
            <div class="role-desc-box" id="roleDesc">
                <i class="bi bi-info-circle-fill me-1 text-primary"></i>
                <span id="roleDescText">Toàn quyền Ban Quản Lý: Dashboard KPI, sơ đồ phòng, đối soát VietQR, hợp đồng cư dân.</span>
            </div>

            <!-- Login Form -->
            <form asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="VaiTro" id="hiddenVaiTro" value="Admin" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3 text-danger border-0 rounded-3" style="background: rgba(239, 68, 68, 0.15); font-size: 13px;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @Html.ValidationSummary(true, "")
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label" for="TenDangNhap">Tên đăng nhập / Số điện thoại</label>
                    <div class="input-group-custom">
                        <i class="bi bi-person-fill prefix-icon"></i>
                        <input asp-for="TenDangNhap" class="form-control-custom" id="txtUsername" placeholder="Nhập tên đăng nhập..." required />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-danger fs-8"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="MatKhau">Mật khẩu</label>
                    <div class="input-group-custom">
                        <i class="bi bi-lock-fill prefix-icon"></i>
                        <input asp-for="MatKhau" type="password" class="form-control-custom" id="txtPassword" placeholder="Nhập mật khẩu..." required />
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility()">
                            <i class="bi bi-eye-slash-fill" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger fs-8"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="GhiNho" id="chkRemember" style="background-color: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                        <label class="form-check-label text-muted fs-8" for="chkRemember">
                            Ghi nhớ phiên làm việc
                        </label>
                    </div>
                    <a href="javascript:void(0)" onclick="alert('Vui lòng liên hệ Quản trị viên để đặt lại mật khẩu.')" class="text-muted fs-8 text-decoration-none">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-login">
                    <i class="bi bi-box-arrow-in-right me-1"></i> ĐĂNG NHẬP VÀO HỆ THỐNG
                </button>

                <div class="mt-3 p-3 rounded-3 text-center" style="background: rgba(37, 99, 235, 0.1); border: 1px solid rgba(56, 189, 248, 0.25);">
                    <div class="text-muted fs-8 mb-1">Bạn là cư dân sinh sống tại chung cư?</div>
                    <div class="d-flex justify-content-center align-items-center gap-3">
                        <a asp-action="CuDanLogin" asp-controller="Account" class="text-info fs-8 fw-bold text-decoration-none">
                            <i class="bi bi-door-open-fill me-1"></i> Cổng Đăng Nhập Cư Dân
                        </a>
                        <span class="text-secondary">•</span>
                        <a asp-action="Register" asp-controller="Account" class="text-info fs-8 fw-bold text-decoration-none">
                            <i class="bi bi-person-plus-fill me-1"></i> Đăng Ký Cư Dân Mới
                        </a>
                    </div>
                </div>
            </form>

            <div class="footer-tag">
                <div>Đồ Án Chuyên Ngành: <strong>SmartStay 2026</strong></div>
                <div class="mt-1" style="color: #475569;">Kiến trúc Microservices .NET 8 • SQL Server • Flutter Mobile App</div>
            </div>
        </div>
    </div>

    <script>
        function selectRole(role, username, password, description) {
            document.getElementById('hiddenVaiTro').value = role;
            document.getElementById('txtUsername').value = username;
            document.getElementById('txtPassword').value = password;
            document.getElementById('roleDescText').innerText = description;

            // Highlight button
            const buttons = document.querySelectorAll('.role-btn');
            buttons.forEach(b => b.classList.remove('active'));

            if (role === 'Admin') {
                buttons[0].classList.add('active');
            } else if (role === 'KyThuat') {
                buttons[1].classList.add('active');
            } else {
                buttons[2].classList.add('active');
            }
        }

        function togglePasswordVisibility() {
            const passField = document.getElementById('txtPassword');
            const eyeIcon = document.getElementById('eyeIcon');
            if (passField.type === 'password') {
                passField.type = 'text';
                eyeIcon.classList.remove('bi-eye-slash-fill');
                eyeIcon.classList.add('bi-eye-fill');
            } else {
                passField.type = 'password';
                eyeIcon.classList.remove('bi-eye-fill');
                eyeIcon.classList.add('bi-eye-slash-fill');
            }
        }
    </script>
</body>
</html>
